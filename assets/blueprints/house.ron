// The house every agent lives in, as the realm builds it. The game
// gives the entry graph `house` the traits it picked for the agent:
// its size, storeys, roof (0 gable, 1 fronted, 2 hip, 3 saltbox),
// walls (0 plaster, 1 ochre, 2 whitewash, 3 stone, 4 framed), garden
// (0 to 3, 4 none), wings, and whether it is the hall and flies the
// mayor's banner. The door faces +z. `block` puts an asset down as a
// box by its middle and half its size; `put` and `slope` by the point
// it stands at.
(
    entry: "house",
    sheets: {
        "block": (
            graph: (
                inputs: [
                    (name: "cx", value_type: Number, default: Some(Number(0.0))),
                    (name: "cy", value_type: Number, default: Some(Number(0.5))),
                    (name: "cz", value_type: Number, default: Some(Number(0.0))),
                    (name: "hx", value_type: Number, default: Some(Number(0.5))),
                    (name: "hy", value_type: Number, default: Some(Number(0.5))),
                    (name: "hz", value_type: Number, default: Some(Number(0.5))),
                    (name: "turn", value_type: Point, default: Some(Point((0.0, 0.0, 0.0)))),
                    (name: "asset", value_type: Choice, default: Some(Choice("box"))),
                ],
                outputs: [(name: "objects", value_type: Objects, from: (node: 21, name: "objects"))],
