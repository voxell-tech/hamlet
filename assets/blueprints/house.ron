                    (id: 10, does: Kind("point")),
                    (id: 11, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(2.0))}),
                    (id: 12, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(2.0))}),
                    (id: 13, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(2.0))}),
                    (id: 14, does: Kind("point")),
                    (id: 15, does: Kind("transform")),
                    (id: 16, does: Kind("object")),
                    (id: 17, does: Kind("transform")),
                    (id: 18, does: Kind("matmul"), settings: {"about": Fixed(Choice("origin"))}),
                    (id: 19, does: Kind("point")),
