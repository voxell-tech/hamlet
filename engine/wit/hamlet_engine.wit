/// The interface between the engine and a plugin. A `list<u8>` is
/// postcard bytes of a type of `hamlet_engine_api`.
package hamlet:engine@0.1.0;

/// What the engine gives a plugin.
interface host {
    enum level {
        info,
        warn,
        error,
    }

    /// Writes a line to the engine's log.
    log: func(level: level, text: string);

    // Each request below gives a ticket, and its `Reply` comes in a
    // later `receive` with that ticket. A ticket of 0 means the
    // request was not taken: one call made too many, handed over too
    // many bytes, or gave one that cannot be read.

    /// Makes an asset of the type `kind`, one the plugin makes.
    create-asset: func(kind: string, name: string, bytes: list<u8>) -> u64;

    /// Reads the asset `id`: its `Asset`.
    read-asset: func(id: u64) -> u64;

    /// Gives one of the plugin's own assets new bytes.
    update-asset: func(id: u64, bytes: list<u8>) -> u64;

    /// Takes one of the plugin's own assets away.
    delete-asset: func(id: u64) -> u64;

    /// Lists the assets of the type `kind`: their `AssetInfo`s.
    list-assets: func(kind: string) -> u64;

    /// Holds a reference to the asset `id`: a `Changed` message comes
    /// each time it is at a new version, and `Gone` when it goes.
    hold-asset: func(id: u64) -> u64;

    /// Lets go of the asset `id`.
    release-asset: func(id: u64) -> u64;

    /// Calls the service `service` (`plugin.id/name`) of another
    /// plugin with `argument`: its result, `Answered`.
    call: func(service: string, argument: list<u8>) -> u64;

    /// Subscribes to the event `event` (`plugin.id/name`) of another
    /// plugin: each comes as an `Event` message.
    subscribe: func(event: string) -> u64;

    /// Sends the plugin's event `event` with `payload` to its
    /// subscribers. A reply comes only when it is refused.
    emit: func(event: string, payload: list<u8>) -> u64;

    /// Fetches a `FetchRequest` from a host the plugin asked for:
    /// `Fetched`.
    fetch: func(request: list<u8>) -> u64;

    /// Asks the agents service an `AgentsRequest`: `Agents`.
    agents: func(request: list<u8>) -> u64;

    /// Asks the desktop service a `DesktopRequest`: `Desktop`.
    desktop: func(request: list<u8>) -> u64;
}

/// What a plugin gives the engine.
interface guest {
    /// What the plugin adds: a `Vec<Contribution>`.
    declare: func() -> list<u8>;

    /// Runs the plugin's command `name`.
    run: func(name: string);

    /// The plugin's state, handed to its next version on a reload.
    save: func() -> list<u8>;

    /// Takes the state an earlier version saved.
    restore: func(state: list<u8>);

    /// What the engine has for the plugin: a `Vec<Message>`.
    receive: func(messages: list<u8>);

    /// Serves a call of its service `service` by the plugin `caller`:
    /// the result, or why it failed.
    serve: func(service: string, caller: string, argument: list<u8>) -> result<list<u8>, string>;
}

/// Panels a plugin builds and keeps node by node, as fynix's backend
/// does: the engine builds its own widgets from them, in its styles.
interface ui {
    /// What a node is. A frame, a button, a list and a scroll hold
    /// nodes; the others hold none.
    enum kind {
        /// A column or a row, by its `direction`.
        frame,
        label,
        /// A button in its `style`. Holding nothing, it shows its
        /// `text`; holding an icon and a label, it sets them out as
        /// the engine's icon buttons do.
        button,
        /// An icon of the engine's set, named by its `text`.
        icon,
        /// A switch showing `on`, and its `text` beside it if any.
        /// The person switching it is a `toggled`.
        toggle,
        /// Text to edit, showing `text`, and `placeholder` while it
        /// is empty. What the person leaves in it is a `committed`.
        /// With more than one of `lines`, Enter sends what is typed
        /// as a `submitted` and empties it.
        field,
        /// The rows of a list, a divider between each.
        %list,
        /// A column that scrolls. One that sticks is a `reached-top`
        /// each time it is scrolled to its top.
        scroll,
        /// A line across.
        divider,
        /// One of its `options` shown, the one `selected`, opening a
        /// list of them to pick another from. The person picking one
        /// is a `picked`.
        dropdown,
    }

    enum direction {
        column,
        row,
    }

    /// Room between the children of a frame, or around them.
    enum space {
        none,
        half,
        gap,
        double,
    }

    /// Where the children of a frame sit along it.
    enum align {
        start,
        end,
    }

    /// What a frame is drawn on, by role.
    enum fill {
        /// Nothing.
        none,
        /// A card: a shade above the panel, in a frame.
        card,
        /// The accent's, as what the chief said is.
        accent,
        /// A round one, as about a speaker's picture.
        disc,
    }

    /// One item of a node's menu.
    record menu-item {
        /// Its words.
        text: string,
        /// The words of the item it is under, which opens a menu of
        /// those under it beside the menu, or none if empty.
        group: string,
        /// It refuses, stops or throws away.
        critical: bool,
    }

    /// A menu a node opens at the pointer on a right-click.
    record menu {
        items: list<menu-item>,
        /// It opens on a click too.
        click: bool,
    }

    /// The colour of text, by role.
    enum tone {
        body,
        dim,
        faint,
        accent,
        critical,
    }

    /// The size of text, by role. A title is in the display face.
    enum size {
        small,
        body,
        heading,
        title,
    }

    /// The face of text: the body's, or the display face of titles
    /// and buttons, which does not wrap.
    enum face {
        body,
        display,
    }

    enum button-style {
        plain,
        primary,
        critical,
        quiet,
        /// A row of a list that leads somewhere, its last child at
        /// its end.
        row,
    }

    /// A movement the engine animates a value over, by its theme.
    enum motion {
        interact,
        expand,
    }

    /// A pointer of the engine's set, by what it says can be done
    /// where it is. The engine draws each.
    enum pointer-mode {
        point,
        /// Over what can be pressed.
        press,
        /// Over a thing of a scene that can be selected.
        pick,
        /// Over what can be taken hold of.
        grab,
        /// Holding something.
        carry,
        /// Sliding the ground of a view.
        slide,
        /// Turning a view.
        turn,
        /// Over text that can be typed in.
        write,
        /// Resizing west to east, north to south, north-west to
        /// south-east and south-west to north-east.
        resize-across,
        resize-upright,
        resize-falling,
        resize-rising,
        /// What is asked is not allowed here.
        refuse,
        /// About to be busy.
        wait,
    }

    /// The pointer a node asks for.
    record node-pointer {
        mode: pointer-mode,
        /// Drawn faint, so what is under it is seen through it.
        faint: bool,
    }

    /// One property of a node, of the kinds named. A node starts with
    /// each at its first value: empty, `body`, `body`, false, `body`,
    /// 1.0, `plain`, `column`, `gap`, empty, false, (0.0, 0.0),
    /// empty, 0, 1, false, empty, `start`, `none`, no items, empty,
    /// `none`, 0, none. A
    /// role is filled in from the engine's theme as it is now, again
    /// whenever the theme changes.
    variant property {
        /// Of a label, a button, an icon, a toggle and a field.
        text(string),
        /// Of a label and an icon.
        tone(tone),
        /// Of a label.
        size(size),
        /// Of a label.
        bold(bool),
        /// Of a label.
        face(face),
        /// Of every kind: how opaque the node itself is.
        opacity(f32),
        /// Of a button.
        style(button-style),
        /// Of a frame.
        direction(direction),
        /// Of a frame.
        space(space),
        /// Of a field.
        placeholder(string),
        /// Of a toggle.
        on(bool),
        /// Of every kind: how far the node is moved, across and down,
        /// from where it is laid out, in the interface's pixels.
        offset(tuple<f32, f32>),
        /// Of a dropdown: what it offers.
        options(list<string>),
        /// Of a dropdown: the place of the option shown.
        selected(u32),
        /// Of a field: the most lines it grows to as it is typed in.
        /// With more than one, Enter sends, Shift+Enter adds a line
        /// and Escape keeps what is typed and leaves it.
        lines(u32),
        /// Of a scroll: it keeps to its end as what it holds grows,
        /// until the person scrolls up, and again once they are back
        /// at its end. What is put above it after a `reached-top`
        /// leaves what was shown where it was.
        stick(bool),
        /// Of every kind: words shown near the pointer while it rests
        /// on the node, or none if empty.
        tip(string),
        /// Of a frame.
        align(align),
        /// Of a frame: what it is drawn on. A frame with a fill is
        /// padded and no wider than what holds it.
        fill(fill),
        /// Of every kind: the menu it opens, or none with no items.
        /// The person choosing an item is a `chose`.
        menu(menu),
        /// Of a button: the title of the system's dialog a folder is
        /// chosen in, which a press opens in place of a `click`, or
        /// none if empty. The folder chosen is a `chosen`.
        folder(string),
        /// Of a frame: room between its edges and what it holds,
        /// past what its fill pads it by.
        padding(space),
        /// Of a frame: its share of the room left along what holds
        /// it, none at 0.
        grow(f32),
        /// Of every kind: the pointer shown while it is over the node
        /// or what it holds, unless what it holds asks for another,
        /// or none to leave it to what holds the node.
        pointer(option<node-pointer>),
    }

    /// What an item of the status line shows.
    record status-item {
        /// An icon of the engine's set, by its name, or none if
        /// empty.
        icon: string,
        /// Its words; an item with none is hidden.
        text: string,
        /// The colour of its icon and words.
        tone: tone,
        /// Words shown while the pointer rests on it, or none if
        /// empty.
        tip: string,
    }

    /// Shows `item` in the plugin's status item `name`.
    set-status: func(name: string, item: status-item);

    /// Shows the plugin's overlay `name` over the dock, or hides it.
    /// Its view is mounted as a panel's is while it is shown.
    show-overlay: func(name: string, shown: bool);

    /// Says how many things the plugin's panel section `name` holds.
    /// One that holds none is hidden.
    set-section: func(name: string, holds: u32);

    /// Brings the plugin's panel `name` to the front, or shows its
    /// settings page `name` in Settings and brings Settings to the
    /// front. A full id, `plugin.id/name`, brings the panel of that
    /// id to the front, of any plugin, if there is one.
    open: func(name: string);

    /// Opens a menu of `items` at the pointer, over everything. The
    /// item chosen is a `chose` of `key`, by its place; the menu
    /// closed by a press elsewhere or Escape is a `closed` of `key`.
    open-menu: func(key: u32, items: list<menu-item>);

    /// What a card is drawn on.
    enum card-look {
        /// Nothing: what it holds as it is.
        plain,
        /// The panels' card in the frame of what floats, as a card of
        /// what is under the pointer.
        card,
        /// The panels' card in the frame of what waits for the
        /// person, as a tag hung in the world.
        tag,
        /// A menu's surface.
        menu,
    }

    /// Where a card is shown.
    enum card-place {
        hidden,
        /// Beside the pointer, out of its way, following it; the
        /// pointer reaches what is under it.
        pointer,
        /// Where the pointer is now, over everything, as a menu
        /// opens: a press elsewhere or Escape closes it, a `closed`
        /// of its key.
        here,
    }

    /// A card of the plugin's own nodes, floating over the window:
    /// the frame its nodes are made under, hidden until it is
    /// placed. `key` names it in the events it is given. It is
    /// `widest` pixels wide at most. Dropping the frame takes it
    /// away.
    make-card: func(key: u32, look: card-look, widest: f32) -> node;

    /// Shows `card`, a frame `make-card` gave, at `place`, or hides
    /// it.
    place-card: func(card: borrow<node>, place: card-place);

    /// A node of a panel. Dropping it takes it away, and every node
    /// under it.
    resource node {
        /// A node of `kind`, last under `parent`, a node that holds
        /// others. `key` is the plugin's name for it in the events it
        /// is given.
        constructor(kind: kind, parent: borrow<node>, key: u32);

        /// Sets `value`, a property of the node's kind, at once, or
        /// moves it from where it is shown over the engine's curve for
        /// `motion`. A tone, size, opacity, space or offset can move;
        /// the rest are set at once.
        set: func(value: property, motion: option<motion>);

        /// Puts the children in the order `children` lists them all.
        reorder: func(children: list<borrow<node>>);

        /// Tells the plugin when the pointer comes over the node or
        /// leaves it, if `hover`, and when a button goes down on it
        /// or up, if `press`.
        watch: func(hover: bool, press: bool);
    }
}

/// What a plugin with retained panels gives the engine.
interface ui-guest {
    use ui.{node};

    variant action {
        click,
        hover(bool),
        press(bool),
        /// A toggle switched, to this.
        toggled(bool),
        /// A field's text, as the person left it.
        committed(string),
        /// A dropdown's option picked, by its place.
        picked(u32),
        /// What was typed in a field of several lines as Enter sent
        /// it.
        submitted(string),
        /// A scroll that sticks was scrolled to its top, or holds too
        /// little to scroll: once for each height of what it holds.
        reached-top,
        /// An item of a node's menu chosen, by its place.
        chose(u32),
        /// The folder chosen in the dialog a button opened, by its
        /// path.
        chosen(string),
        /// A menu `open-menu` opened, or a card placed `here`, closed
        /// with nothing chosen.
        closed,
    }

    /// What the person did to the node the plugin named `key`.
    record ui-event {
        key: u32,
        action: action,
    }

    /// Seconds a movement of the theme takes.
    record motions {
        interact: f32,
        expand: f32,
    }

    // Each call answers whether something still moves, so the engine
    // calls `frame` on the next frame.

    /// Builds the panel or settings page `name` under `root`.
    mount: func(name: string, root: node, motions: motions) -> bool;

    /// Lets go of the panel or settings page `name`, whose nodes are
    /// gone.
    unmount: func(name: string);

    input: func(events: list<ui-event>) -> bool;

    /// A frame passed, `micros` after the last.
    frame: func(micros: u32) -> bool;
}

world plugin {
    import host;
    export guest;
}

/// The engine's side of a plugin's panels and settings pages, apart
/// from `plugin`.
world ui-panels {
    import ui;
    export ui-guest;
}

/// A plugin with panels or settings pages.
world ui-plugin {
    include plugin;
    include ui-panels;
}

/// 3D scenes a plugin keeps entity by entity, as Bevy's ECS holds
/// them, drawn by the engine. Each call is one change, and only
/// changes cross. Dropping a handle takes its thing away. A make
/// fails, saying why, past a limit the person set or without
/// `render.scene`.
interface scene {
    use ui.{node};

    /// x, y and z.
    type vec3 = tuple<f32, f32, f32>;
    /// A rotation as a quaternion: x, y, z and w.
    type quat = tuple<f32, f32, f32, f32>;
    /// A colour: linear red, green, blue and alpha.
    type rgba = tuple<f32, f32, f32, f32>;

    record transform {
        translation: vec3,
        rotation: quat,
        scale: vec3,
    }

    /// A shape of the engine's, centred on the origin.
    variant shape {
        /// Its size along x, y and z.
        cuboid(vec3),
        /// Its radius.
        sphere(f32),
        /// A square facing up: its size along x and z.
        plane3d(tuple<f32, f32>),
        /// Its radius and height.
        cylinder(tuple<f32, f32>),
        /// Its radius and the length of its middle.
        capsule3d(tuple<f32, f32>),
        /// Its radius and height.
        cone(tuple<f32, f32>),
        /// The radius of its tube and of its ring.
        torus(tuple<f32, f32>),
    }

    /// Triangles. A list other than `positions` and `indices` may be
    /// empty.
    record mesh-data {
        /// x, y and z of each vertex.
        positions: list<f32>,
        /// x, y and z of each vertex; empty, made from the triangles.
        normals: list<f32>,
        /// u and v of each vertex.
        uvs: list<f32>,
        /// Linear red, green, blue and alpha of each vertex, which the
        /// material's colour is multiplied by.
        colors: list<f32>,
        /// Three vertices for each triangle, counter-clockwise seen
        /// from its front.
        indices: list<u32>,
    }

    enum alpha-mode {
        opaque,
        mask,
        blend,
        premultiplied,
        add,
        multiply,
    }

    /// Bevy's standard material.
    record standard-material {
        base-color: rgba,
        /// Light it gives off; past 1 it blooms.
        emissive: rgba,
        /// From 0, a mirror, to 1.
        perceptual-roughness: f32,
        metallic: f32,
        /// How much light a surface that is not metal reflects
        /// head-on, 0 to 1; 0.5 is 4%.
        reflectance: f32,
        alpha-mode: alpha-mode,
        /// Under it a `mask` material shows nothing.
        alpha-cutoff: f32,
        /// Shown in its colour, not lit.
        unlit: bool,
        double-sided: bool,
        /// Covered by the camera's fog.
        fog-enabled: bool,
    }

    /// The look of a decal, as Bevy's forward decal draws it: a
    /// standard material, always blended.
    record decal {
        /// Times its texture's, where it has one; the alpha is how
        /// much of what it falls on it covers.
        base-color: rgba,
        /// Light it gives off; past 1 it blooms.
        emissive: rgba,
        /// Shown in its colour, not lit.
        unlit: bool,
        /// Covered by the camera's fog.
        fog-enabled: bool,
        /// How far from its square, in the world's units, what it
        /// falls on may lie before it fades out.
        depth-fade-factor: f32,
    }

    /// Light from far away along the entity's forward, -z, in lux.
    record directional-light {
        color: rgba,
        illuminance: f32,
        shadow-maps-enabled: bool,
    }

    /// Light from the entity, in lumens, reaching `range`.
    record point-light {
        color: rgba,
        intensity: f32,
        range: f32,
        radius: f32,
        shadow-maps-enabled: bool,
    }

    /// A point light in a cone along the entity's forward, its angles
    /// in radians from its middle.
    record spot-light {
        color: rgba,
        intensity: f32,
        range: f32,
        radius: f32,
        inner-angle: f32,
        outer-angle: f32,
        shadow-maps-enabled: bool,
    }

    variant light {
        directional(directional-light),
        point(point-light),
        spot(spot-light),
    }

    /// A box of haze one unit each way about the entity, placed,
    /// turned and sized by its transform, shown by a camera with
    /// volumetric fog where a volumetric light lights it.
    record fog-volume {
        fog-color: rgba,
        density-factor: f32,
        /// The share of light it takes at each step, and the share it
        /// scatters.
        absorption: f32,
        scattering: f32,
        /// From -1 to 1: how much more it scatters toward the camera.
        scattering-asymmetry: f32,
        light-tint: rgba,
        light-intensity: f32,
    }

    variant projection {
        /// Its vertical field of view in radians, near and far.
        perspective(vec3),
        /// The height it shows in the world's units, near and far.
        orthographic(vec3),
    }

    /// How a camera's high range is brought into the screen's.
    enum tonemapping {
        none,
        reinhard,
        reinhard-luminance,
        aces-fitted,
        ag-x,
        somewhat-boring-display-transform,
        tony-mc-mapface,
        blender-filmic,
        khronos-pbr-neutral,
    }

    /// Samples a pixel is drawn with.
    enum msaa {
        off,
        sample2,
        sample4,
        sample8,
    }

    /// How the edges of shadows are smoothed.
    enum shadow-filtering-method {
        hardware2x2,
        gaussian,
        temporal,
    }

    variant fog-falloff {
        /// Where it begins and where it is whole.
        linear(tuple<f32, f32>),
        /// Its density.
        exponential(f32),
        exponential-squared(f32),
    }

    record distance-fog {
        color: rgba,
        falloff: fog-falloff,
    }

    record bloom-prefilter {
        /// Light under it does not bloom.
        threshold: f32,
        /// From 0 to 1: how softly the threshold cuts in.
        threshold-softness: f32,
    }

    record bloom {
        intensity: f32,
        low-frequency-boost: f32,
        prefilter: bloom-prefilter,
    }

    record exposure {
        /// In EV100.
        ev100: f32,
    }

    /// Light from everywhere.
    record ambient-light {
        color: rgba,
        brightness: f32,
    }

    /// What a camera is drawn with. It is drawn without MSAA while it
    /// has `screen-space-ambient-occlusion`, which Bevy needs.
    record camera-settings {
        projection: projection,
        /// What it clears to before it draws; none draws over what is
        /// there.
        clear-color: option<rgba>,
        /// Drawn in high range; bloom needs it.
        hdr: bool,
        tonemapping: tonemapping,
        exposure: exposure,
        distance-fog: option<distance-fog>,
        bloom: option<bloom>,
        ambient-light: ambient-light,
        msaa: msaa,
        shadow-filtering-method: shadow-filtering-method,
    }

    enum depth-of-field-mode {
        bokeh,
        gaussian,
    }

    /// Bevy's depth of field: what is not at `focal-distance` is
    /// blurred.
    record depth-of-field {
        mode: depth-of-field-mode,
        focal-distance: f32,
        /// In metres.
        sensor-height: f32,
        aperture-f-stops: f32,
        /// The widest a blur is, in pixels.
        max-circle-of-confusion-diameter: f32,
        /// Past it nothing is blurred; may be infinite.
        max-depth: f32,
    }

    /// Bevy's colour grading of the whole image.
    record color-grading-global {
        /// In EV, on top of the camera's exposure.
        exposure: f32,
        temperature: f32,
        tint: f32,
        /// In radians.
        hue: f32,
        /// 1 as drawn, 0 grey.
        post-saturation: f32,
    }

    record color-grading {
        global: color-grading-global,
    }

    enum smaa-preset {
        low,
        medium,
        high,
        ultra,
    }

    record smaa {
        preset: smaa-preset,
    }

    enum screen-space-ambient-occlusion-quality-level {
        low,
        medium,
        high,
        ultra,
    }

    /// Bevy's screen-space ambient occlusion: darkening where
    /// surfaces meet.
    record screen-space-ambient-occlusion {
        quality-level: screen-space-ambient-occlusion-quality-level,
        /// How thick a surface is taken to be, in the world's units.
        constant-object-thickness: f32,
    }

    /// Bevy's volumetric fog: the fog volumes of the scene, lit by
    /// its volumetric lights.
    record volumetric-fog {
        ambient-color: rgba,
        ambient-intensity: f32,
        /// Steps through the fog.
        step-count: u32,
        /// How far each ray's start is moved at random.
        jitter: f32,
    }

    /// What a camera draws over its image, each off when none.
    record camera-effects {
        depth-of-field: option<depth-of-field>,
        color-grading: color-grading,
        /// Draws without MSAA.
        screen-space-ambient-occlusion: option<screen-space-ambient-occlusion>,
        smaa: option<smaa>,
        /// The engine's scattering sky, of an earth-like world, in
        /// place of what the camera clears to. Draws in high range.
        atmosphere: bool,
        /// One plugin's at a time: another's is not drawn.
        volumetric-fog: option<volumetric-fog>,
    }

    /// Where a camera draws.
    enum target {
        /// An image shown by `show-in`, sized by the layout.
        viewport,
        /// The window, behind the dock. One plugin at a time.
        background,
    }

    resource mesh {
        shape: static func(shape: shape) -> result<mesh, string>;

        /// `data`, checked.
        build: static func(data: mesh-data) -> result<mesh, string>;

        /// Gives the mesh `data` in place of what it had.
        update: func(data: mesh-data) -> result<_, string>;
    }

    resource material {
        make: static func(standard-material: standard-material) -> result<material, string>;

        /// A material of one colour for `draw-decal`.
        decal: static func(decal: decal) -> result<material, string>;

        set: func(standard-material: standard-material);

        /// Gives a decal's material `decal`, keeping its texture.
        set-decal: func(decal: decal);
    }

    /// An entity, at the scene's root or under `parent`.
    resource entity {
        /// `key` is the plugin's name for it in what it is told.
        make: static func(parent: option<borrow<entity>>, key: u32) -> result<entity, string>;

        set-transform: func(transform: transform);

        set-visible: func(visible: bool);

        set-parent: func(parent: option<borrow<entity>>);

        /// Draws `mesh` with `material` at the entity.
        draw: func(mesh: borrow<mesh>, material: borrow<material>);

        /// Lays a decal of `material`, a decal's, at the entity: a
        /// square one unit wide on its x and z, laid on what lies
        /// under and over it along its y. Its transform places, turns
        /// and sizes it.
        draw-decal: func(material: borrow<material>);

        undraw: func();

        /// Makes the entity a light, or none.
        set-light: func(light: option<light>) -> result<_, string>;

        /// Whether it casts shadows and is shadowed.
        set-shadows: func(cast: bool, receive: bool);

        /// Whether the entity's directional light, with shadows,
        /// lights fog volumes.
        set-volumetric: func(on: bool);

        /// Makes the entity a fog volume, or none. One plugin's fog
        /// volumes are drawn at a time.
        set-fog-volume: func(volume: option<fog-volume>) -> result<_, string>;

        /// Words shown over the entity in each view of the scene.
        set-label: func(label: option<label>);

        /// A balloon over the entity in each view of the scene. It
        /// pops in as it comes and shrinks away as it goes.
        set-balloon: func(balloon: option<balloon>);

        /// Hangs `card`, a frame `make-card` gave, `gap` pixels over
        /// the entity in the first view of the scene that shows it,
        /// cut where the view ends, or takes it down. Placing the
        /// card takes it down too.
        hang-card: func(card: option<borrow<node>>, gap: f32);

        /// Tells the plugin when the pointer comes over it or leaves,
        /// if `hover`, and when it is clicked, if `click`.
        watch: func(hover: bool, click: bool);
    }

    /// How words over an entity look.
    enum label-look {
        /// Small words of the interface's colour.
        plain,
        /// A sign, as over a named thing, in a dark box with a dim
        /// gold edge.
        sign,
        /// A name tag, as over what the pointer is on: larger, in a
        /// brighter gold edge.
        tag,
    }

    /// Words over an entity, centred over it.
    record label {
        text: string,
        look: label-look,
        /// Pixels between the entity and the label's foot.
        gap: f32,
        /// The farthest the camera is from the entity for it to be
        /// shown, in the world's units, or any distance at 0.
        far: f32,
    }

    /// A balloon of speech or thought, its point on the entity.
    record balloon {
        /// Its words, or, with none, dots that swell in turn.
        text: string,
        /// Dimmer, trailing rounds in place of a point.
        thought: bool,
        /// Pixels between the entity and the balloon's point.
        gap: f32,
        /// The farthest the camera is from the entity for it to be
        /// shown, in the world's units, or any distance at 0.
        far: f32,
    }

    /// Words beside the pointer while it is over a view of the
    /// plugin's.
    record pointer-label {
        text: string,
        /// The colour of the words, and of what they are on.
        color: rgba,
        back: rgba,
        /// The size of the words, in the interface's pixels.
        size: f32,
        /// Where its top left is from the pointer, in the interface's
        /// pixels.
        x: f32,
        y: f32,
    }

    /// Shows `label` beside the pointer, or none.
    set-pointer-label: func(label: option<pointer-label>);

    /// Copies of one mesh in one material, drawn together, under
    /// `parent` or at the scene's root. Copy `i` is tagged `i` for a
    /// shader.
    resource instances {
        make: static func(parent: option<borrow<entity>>, mesh: borrow<mesh>, material: borrow<material>, key: u32) -> result<instances, string>;

        /// A copy for each ten floats: translation, rotation and scale.
        set: func(transforms: list<f32>) -> result<_, string>;

        watch: func(hover: bool, click: bool);
    }

    /// A camera at an entity, looking along its forward.
    resource camera {
        make: static func(at: borrow<entity>, settings: camera-settings, target: target) -> result<camera, string>;

        set: func(settings: camera-settings);

        set-effects: func(effects: camera-effects) -> result<_, string>;

        /// Shows the camera's image in `frame`, a frame of one of the
        /// plugin's panels, filling it. The pointer and wheel over it
        /// are told to the plugin.
        show-in: func(frame: borrow<node>);
    }

    /// Has the engine call `tick` each frame while `on`.
    animate: func(on: bool);

    /// The side of each cascade of a directional light's shadow, in
    /// texels: a power of two, at most the GPU's widest texture. The
    /// engine draws the largest any scene asks for, 2048 when none
    /// does.
    shadow-map: func(size: u32) -> result<_, string>;
}

/// What a plugin with scenes gives the engine.
interface scene-guest {
    use scene.{vec3};

    /// Where the pointer met a watched entity.
    record hit {
        /// The entity's key, or the instances' key and the copy.
        key: u32,
        index: u32,
        position: vec3,
        normal: vec3,
    }

    enum mouse-button {
        primary,
        secondary,
        middle,
    }

    /// The buttons held down.
    flags buttons {
        primary,
        secondary,
        middle,
    }

    /// The keys held with what the person did. `meta` is Command on
    /// macOS and the system's key elsewhere.
    flags modifiers {
        shift,
        control,
        alt,
        meta,
    }

    /// The pointer over a camera's view: the key of the camera's
    /// entity, where in the view's pixels from its top left, and how
    /// far it moved.
    record pointer {
        view: u32,
        x: f32,
        y: f32,
        dx: f32,
        dy: f32,
        buttons: buttons,
        modifiers: modifiers,
    }

    record press {
        view: u32,
        button: mouse-button,
        down: bool,
        x: f32,
        y: f32,
        modifiers: modifiers,
    }

    /// A press let go over a watched entity, as near as a click is to
    /// where it began.
    record click {
        hit: hit,
        button: mouse-button,
        modifiers: modifiers,
    }

    /// A key of the keyboard, by where it is.
    enum key-code {
        key-a, key-b, key-c, key-d, key-e, key-f, key-g, key-h,
        key-i, key-j, key-k, key-l, key-m, key-n, key-o, key-p,
        key-q, key-r, key-s, key-t, key-u, key-v, key-w, key-x,
        key-y, key-z,
        digit0, digit1, digit2, digit3, digit4,
        digit5, digit6, digit7, digit8, digit9,
        f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12,
        escape, enter, space, tab, backspace, delete,
        arrow-up, arrow-down, arrow-left, arrow-right, home, end,
        page-up, page-down,
        comma, period, slash, backslash, semicolon, quote,
        backquote, minus, equal, bracket-left, bracket-right,
    }

    /// A key pressed or let go while the pointer is over a view, or
    /// a view was the last pressed. A key typed in a field, one bound
    /// to a shortcut of the engine's, and one pressed while a menu or
    /// a card placed `here` is open are not told.
    record key {
        view: u32,
        code: key-code,
        down: bool,
        modifiers: modifiers,
    }

    /// A file of the person's dropped on a view, told to a plugin
    /// allowed `desktop.drop`.
    record dropped {
        view: u32,
        x: f32,
        y: f32,
        /// The engine's number for the drop, by which a service is
        /// handed the file.
        id: u32,
        path: string,
    }

    /// The wheel turned over a view, in lines.
    record scroll {
        view: u32,
        x: f32,
        y: f32,
    }

    variant scene-input {
        /// The pointer came over a watched entity.
        over(hit),
        /// The pointer left the watched entity of this key and copy.
        out(tuple<u32, u32>),
        click(click),
        move(pointer),
        press(press),
        scroll(scroll),
        /// A view's new size: its camera's key, width and height.
        resized(tuple<u32, f32, f32>),
        key(key),
        dropped(dropped),
    }

    /// What the person did in the plugin's views.
    input: func(inputs: list<scene-input>);

    /// A frame passed, `micros` after the last.
    tick: func(micros: u32);
}

/// A plugin's own GPU work in WGSL, checked with naga before it is
/// used: materials and passes over a camera's image, with
/// `render.shader`, and compute, with `render.compute`. A source
/// declares no bindings of its own: the engine's are at fixed
/// places, under fixed names. A make fails, saying why, past the
/// device's sizes, past a limit the person set or without its
/// capability.
interface gpu {
    use scene.{alpha-mode, material, camera, decal};

    enum shader-kind {
        /// `fn shade(surface: Surface) -> vec4<f32>`, or `-> Shading`
        /// for its metallic, roughness, reflectance and emissive too,
        /// and optionally `fn displace(vertex: Vertex) -> vec3<f32>`,
        /// which its shadow and depth follow.
        material,
        /// `fn post(drawn: Pass) -> vec4<f32>`.
        pass,
        /// `@compute @workgroup_size(..) fn main(..)`.
        compute,
        /// `fn shade(decal: Decal) -> vec4<f32>`.
        decal,
    }

    resource shader {
        /// `source` checked as a shader of `kind`: the shader, or why
        /// it is refused.
        compile: static func(kind: shader-kind, source: string) -> result<shader, string>;
    }

    /// A storage buffer of the plugin's, of `vec4<f32>` items.
    resource buffer {
        /// `size` bytes, a multiple of 16, zeroed.
        make: static func(size: u32) -> result<buffer, string>;

        /// Writes `bytes` at `offset`, both multiples of 4.
        write: func(offset: u32, bytes: list<u8>) -> result<_, string>;
    }

    /// An image of the plugin's: red, green, blue and alpha bytes of
    /// each pixel, in sRGB, row by row from the top.
    resource texture {
        make: static func(width: u32, height: u32, pixels: list<u8>) -> result<texture, string>;

        write: func(pixels: list<u8>) -> result<_, string>;
    }

    record shaded {
        alpha-mode: alpha-mode,
        double-sided: bool,
        /// Lit by the scene's lights with the colour `shade` gives as
        /// its own; else shown as `shade` gives it.
        lit: bool,
    }

    /// A material drawn by `shader`, a `material` shader, with
    /// `params` (64 floats at most), `texture` and `data` bound. It
    /// casts shadows, as a standard material does.
    shaded-material: func(shader: borrow<shader>, settings: shaded, params: list<f32>, texture: option<borrow<texture>>, data: option<borrow<buffer>>) -> result<material, string>;

    /// Gives a material `shaded-material` or `shaded-decal` made new
    /// `params`.
    set-params: func(material: borrow<material>, params: list<f32>) -> result<_, string>;

    /// A material for `draw-decal`, its colour times `texture`'s.
    decal-material: func(decal: decal, texture: borrow<texture>) -> result<material, string>;

    /// A material for `draw-decal` drawn by `shader`, a `decal`
    /// shader, through a box one unit each way about the entity, with
    /// `params` (64 floats at most), `texture` and `data` bound.
    /// `alpha-mode` is one that blends.
    shaded-decal: func(shader: borrow<shader>, alpha-mode: alpha-mode, params: list<f32>, texture: option<borrow<texture>>, data: option<borrow<buffer>>) -> result<material, string>;

    /// A `compute` shader over `data`, and `extra` when given.
    resource compute {
        make: static func(shader: borrow<shader>, data: borrow<buffer>, extra: option<borrow<buffer>>) -> result<compute, string>;

        set-params: func(params: list<f32>) -> result<_, string>;

        /// Runs it over `x` by `y` by `z` workgroups on the next frame,
        /// and every frame after while `every-frame`.
        dispatch: func(x: u32, y: u32, z: u32, every-frame: bool) -> result<_, string>;
    }

    /// Runs `shader`, a `pass` shader, over the image of `camera` each
    /// frame after it draws, before its tonemapping; none takes the
    /// pass away.
    set-pass: func(camera: borrow<camera>, shader: option<borrow<shader>>, params: list<f32>) -> result<_, string>;
}

/// The engine's side of a plugin's scenes, apart from `plugin`.
world scene-view {
    import scene;
    import gpu;
    export scene-guest;
}

/// Sounds a plugin plays through the engine's audio output, each of
/// a category the person's settings scale. A make or a play fails,
/// saying why, past a limit the person set or without `audio.play`.
interface audio {
    use scene.{vec3, entity};

    /// What a sound is for.
    enum category {
        /// The panels, menus and controls.
        %interface,
        /// What happens in a scene.
        %world,
        music,
        /// Speech and the sounds of those who speak.
        voices,
    }

    record playback {
        category: category,
        /// 0 to 1, of the clip as made.
        volume: f32,
        /// How fast it plays, from 1/4 to 4, 1 as made; its pitch
        /// moves with it.
        speed: f32,
        looped: bool,
    }

    /// Why samples were not appended to a clip.
    variant append-error {
        /// Past the audio memory the person set for the plugin.
        /// Nothing was appended; the same samples may be appended
        /// once more of the clip was heard.
        full,
        /// Not whole finite frames, or the clip is closed or its
        /// sound played to its end.
        refused(string),
    }

    /// Samples as floats from -1 to 1, interleaved: `channels` (1, or
    /// 2 with the left first) a frame, `rate` frames a second, from
    /// 8,000 to 96,000. Held to the plugin's bytes of clips, four a
    /// sample.
    resource clip {
        make: static func(samples: list<f32>, channels: u8, rate: u32) -> result<clip, string>;

        /// An empty clip, filled by `append` until `close`. A sound
        /// may play it while it is filled: past the samples appended
        /// it waits in silence for more, and it loops only once
        /// closed. With `once`, one sound plays it once, not looped,
        /// and its samples count against the bytes of clips only
        /// until they are heard.
        open: static func(channels: u8, rate: u32, once: bool) -> result<clip, string>;

        /// Adds `samples`, whole frames, at its end.
        append: func(samples: list<f32>) -> result<_, append-error>;

        /// No more samples come: a sound playing it ends at its end.
        close: func();
    }

    /// A clip playing. Dropping it stops it; one that is not looped
    /// stops at its end.
    resource sound {
        /// Heard the same wherever the listener is.
        play: static func(clip: borrow<clip>, playback: playback) -> result<sound, string>;

        /// At `point` of the plugin's scene, heard from its listener.
        play-at: static func(clip: borrow<clip>, playback: playback, point: vec3) -> result<sound, string>;

        /// At `at`, an entity of the plugin's scene, following it.
        play-on: static func(clip: borrow<clip>, playback: playback, at: borrow<entity>) -> result<sound, string>;

        /// Its volume and speed from now on.
        set: func(volume: f32, speed: f32);

        /// Moves its volume evenly to `volume` over `seconds`, each
        /// frame in the engine.
        fade: func(volume: f32, seconds: f32);

        /// Whether it still plays: false once it was stopped or came
        /// to its end, as the engine last heard.
        playing: func() -> bool;

        stop: func();
    }

    /// Hears the plugin's placed sounds from `at`, an entity of its
    /// scene, or from its scene's origin.
    listen: func(at: option<borrow<entity>>);
}

/// The engine's side of a plugin's sounds, apart from `plugin`.
world sounds {
    import audio;
}

/// A plugin with panels, scenes and sounds.
world render-plugin {
    include ui-plugin;
    include scene-view;
    include sounds;
}
