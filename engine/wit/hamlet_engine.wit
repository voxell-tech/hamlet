/// The interface between the engine and a plugin. A `list<u8>` is
/// postcard bytes of a type of `hamlet_engine_api`.
package hamlet:engine@0.1.0;

/// What the engine gives a plugin.
interface host {
    enum level {
        info,
        warn,
        error,
    }

    /// Writes a line to the engine's log.
    log: func(level: level, text: string);

    /// Asks for the panel or settings page `name` to be drawn again.
    redraw: func(name: string);

    // Each request below gives a ticket, and its `Reply` comes in a
    // later `receive` with that ticket. A ticket of 0 means the
    // request was not taken: one call made too many.

    /// Makes an asset of the type `kind`, one the plugin makes.
    create-asset: func(kind: string, name: string, bytes: list<u8>) -> u64;

    /// Reads the asset `id`: its `Asset`.
    read-asset: func(id: u64) -> u64;

    /// Gives one of the plugin's own assets new bytes.
    update-asset: func(id: u64, bytes: list<u8>) -> u64;

    /// Takes one of the plugin's own assets away.
    delete-asset: func(id: u64) -> u64;

    /// Lists the assets of the type `kind`: their `AssetInfo`s.
    list-assets: func(kind: string) -> u64;

    /// Holds a reference to the asset `id`: a `Changed` message comes
    /// each time it is at a new version, and `Gone` when it goes.
    hold-asset: func(id: u64) -> u64;

    /// Lets go of the asset `id`.
    release-asset: func(id: u64) -> u64;

    /// Calls the service `service` (`plugin.id/name`) of another
    /// plugin with `argument`: its result, `Answered`.
    call: func(service: string, argument: list<u8>) -> u64;

    /// Subscribes to the event `event` (`plugin.id/name`) of another
    /// plugin: each comes as an `Event` message.
    subscribe: func(event: string) -> u64;

    /// Sends the plugin's event `event` with `payload` to its
    /// subscribers. A reply comes only when it is refused.
    emit: func(event: string, payload: list<u8>) -> u64;
}

/// What a plugin gives the engine.
interface guest {
    /// What the plugin adds: a `Vec<Contribution>`.
    declare: func() -> list<u8>;

    /// The panel or settings page `name`: a `WidgetTree`.
    draw: func(name: string) -> list<u8>;

    /// A `WidgetEvent` on one of its panels or settings pages.
    event: func(event: list<u8>);

    /// Runs the plugin's command `name`.
    run: func(name: string);

    /// The plugin's state, handed to its next version on a reload.
    save: func() -> list<u8>;

    /// Takes the state an earlier version saved.
    restore: func(state: list<u8>);

    /// What the engine has for the plugin: a `Vec<Message>`.
    receive: func(messages: list<u8>);

    /// Serves a call of its service `service` by the plugin `caller`:
    /// the result, or why it failed.
    serve: func(service: string, caller: string, argument: list<u8>) -> result<list<u8>, string>;
}

world plugin {
    import host;
    export guest;
}
