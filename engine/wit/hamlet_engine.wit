/// The interface between the engine and a plugin. A `list<u8>` is
/// postcard bytes of a type of `hamlet_engine_api`.
package hamlet:engine@0.1.0;

/// What the engine gives a plugin.
interface host {
    enum level {
        info,
        warn,
        error,
    }

    /// Writes a line to the engine's log.
    log: func(level: level, text: string);

    // Each request below gives a ticket, and its `Reply` comes in a
    // later `receive` with that ticket. A ticket of 0 means the
    // request was not taken: one call made too many.

    /// Makes an asset of the type `kind`, one the plugin makes.
    create-asset: func(kind: string, name: string, bytes: list<u8>) -> u64;

    /// Reads the asset `id`: its `Asset`.
    read-asset: func(id: u64) -> u64;

    /// Gives one of the plugin's own assets new bytes.
    update-asset: func(id: u64, bytes: list<u8>) -> u64;

    /// Takes one of the plugin's own assets away.
    delete-asset: func(id: u64) -> u64;

    /// Lists the assets of the type `kind`: their `AssetInfo`s.
    list-assets: func(kind: string) -> u64;

    /// Holds a reference to the asset `id`: a `Changed` message comes
    /// each time it is at a new version, and `Gone` when it goes.
    hold-asset: func(id: u64) -> u64;

    /// Lets go of the asset `id`.
    release-asset: func(id: u64) -> u64;

    /// Calls the service `service` (`plugin.id/name`) of another
    /// plugin with `argument`: its result, `Answered`.
    call: func(service: string, argument: list<u8>) -> u64;

    /// Subscribes to the event `event` (`plugin.id/name`) of another
    /// plugin: each comes as an `Event` message.
    subscribe: func(event: string) -> u64;

    /// Sends the plugin's event `event` with `payload` to its
    /// subscribers. A reply comes only when it is refused.
    emit: func(event: string, payload: list<u8>) -> u64;

    /// Fetches a `FetchRequest` from a host the plugin asked for:
    /// `Fetched`.
    fetch: func(request: list<u8>) -> u64;

    /// Asks the agents service an `AgentsRequest`: `Agents`.
    agents: func(request: list<u8>) -> u64;
}

/// What a plugin gives the engine.
interface guest {
    /// What the plugin adds: a `Vec<Contribution>`.
    declare: func() -> list<u8>;

    /// Runs the plugin's command `name`.
    run: func(name: string);

    /// The plugin's state, handed to its next version on a reload.
    save: func() -> list<u8>;

    /// Takes the state an earlier version saved.
    restore: func(state: list<u8>);

    /// What the engine has for the plugin: a `Vec<Message>`.
    receive: func(messages: list<u8>);

    /// Serves a call of its service `service` by the plugin `caller`:
    /// the result, or why it failed.
    serve: func(service: string, caller: string, argument: list<u8>) -> result<list<u8>, string>;
}

/// Panels a plugin builds and keeps node by node, as fynix's backend
/// does: the engine builds its own widgets from them, in its styles.
interface ui {
    /// What a node is. A frame, a button, a list and a scroll hold
    /// nodes; the others hold none.
    enum kind {
        /// A column or a row, by its `direction`.
        frame,
        label,
        /// A button in its `style`. Holding nothing, it shows its
        /// `text`; holding an icon and a label, it sets them out as
        /// the engine's icon buttons do.
        button,
        /// An icon of the engine's set, named by its `text`.
        icon,
        /// A switch showing `on`. The person switching it is a
        /// `toggled`.
        toggle,
        /// A line of text to edit, showing `text`, and `placeholder`
        /// while it is empty. What the person leaves in it is a
        /// `committed`.
        field,
        /// The rows of a list, a divider between each.
        %list,
        /// A column that scrolls.
        scroll,
        /// A line across.
        divider,
    }

    enum direction {
        column,
        row,
    }

    /// Room between the children of a frame.
    enum space {
        none,
        half,
        gap,
        double,
    }

    /// The colour of text, by role.
    enum tone {
        body,
        dim,
        faint,
        accent,
        critical,
    }

    /// The size of text, by role. A title is in the display face.
    enum size {
        small,
        body,
        heading,
        title,
    }

    /// The face of text: the body's, or the display face of titles
    /// and buttons, which does not wrap.
    enum face {
        body,
        display,
    }

    enum button-style {
        plain,
        primary,
        critical,
        quiet,
    }

    /// A movement the engine animates a value over, by its theme.
    enum motion {
        interact,
        expand,
    }

    /// One property of a node, of the kinds named. A node starts with
    /// each at its first value: empty, `body`, `body`, false, `body`,
    /// 1.0, `plain`, `column`, `gap`, empty, false, (0.0, 0.0). A
    /// role is filled in from the engine's theme as it is now, again
    /// whenever the theme changes.
    variant property {
        /// Of a label, a button, an icon and a field.
        text(string),
        /// Of a label and an icon.
        tone(tone),
        /// Of a label.
        size(size),
        /// Of a label.
        bold(bool),
        /// Of a label.
        face(face),
        /// Of every kind: how opaque the node itself is.
        opacity(f32),
        /// Of a button.
        style(button-style),
        /// Of a frame.
        direction(direction),
        /// Of a frame.
        space(space),
        /// Of a field.
        placeholder(string),
        /// Of a toggle.
        on(bool),
        /// Of every kind: how far the node is moved, across and down,
        /// from where it is laid out, in the interface's pixels.
        offset(tuple<f32, f32>),
    }

    /// A node of a panel. Dropping it takes it away, and every node
    /// under it.
    resource node {
        /// A node of `kind`, last under `parent`, a node that holds
        /// others. `key` is the plugin's name for it in the events it
        /// is given.
        constructor(kind: kind, parent: borrow<node>, key: u32);

        /// Sets `value`, a property of the node's kind, at once, or
        /// moves it from where it is shown over the engine's curve for
        /// `motion`. A tone, size, opacity, space or offset can move;
        /// the rest are set at once.
        set: func(value: property, motion: option<motion>);

        /// Puts the children in the order `children` lists them all.
        reorder: func(children: list<borrow<node>>);

        /// Tells the plugin when the pointer comes over the node or
        /// leaves it, if `hover`, and when a button goes down on it
        /// or up, if `press`.
        watch: func(hover: bool, press: bool);
    }
}

/// What a plugin with retained panels gives the engine.
interface ui-guest {
    use ui.{node};

    variant action {
        click,
        hover(bool),
        press(bool),
        /// A toggle switched, to this.
        toggled(bool),
        /// A field's text, as the person left it.
        committed(string),
    }

    /// What the person did to the node the plugin named `key`.
    record ui-event {
        key: u32,
        action: action,
    }

    /// Seconds a movement of the theme takes.
    record motions {
        interact: f32,
        expand: f32,
    }

    // Each call answers whether something still moves, so the engine
    // calls `frame` on the next frame.

    /// Builds the panel or settings page `name` under `root`.
    mount: func(name: string, root: node, motions: motions) -> bool;

    /// Lets go of the panel or settings page `name`, whose nodes are
    /// gone.
    unmount: func(name: string);

    input: func(events: list<ui-event>) -> bool;

    /// A frame passed, `micros` after the last.
    frame: func(micros: u32) -> bool;
}

world plugin {
    import host;
    export guest;
}

/// The engine's side of a plugin's panels and settings pages, apart
/// from `plugin`.
world ui-panels {
    import ui;
    export ui-guest;
}

/// A plugin with panels or settings pages.
world ui-plugin {
    include plugin;
    include ui-panels;
}
