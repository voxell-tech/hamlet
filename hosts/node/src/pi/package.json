{
    "//": "This file was changed for Hamlet. See NOTICE in this package.",
    "name": "@hamlet/pi",
    "version": "0.5.6",
    "description": "Run the Pi coding agent as a durable actor",
    "license": "Apache-2.0",
    "keywords": [
        "pi",
        "coding-agent",
        "agent",
        "ai",
        "hamlet",
        "hamlet_actor",
        "actors",
        "durable"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "files": [
        "dist",
        "package.json"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./durable": {
            "types": "./dist/durable.d.ts",
            "default": "./dist/durable.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check-types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "~1.5.0",
        "@opentelemetry/api": "^1.1.0",
        "@hamlet/sandbox-adapter": "workspace:*"
    },
    "peerDependencies": {
        "@earendil-works/chord": "~1.5.0",
        "@earendil-works/pi-ai": "~1.5.0",
        "@earendil-works/pi-durable": "~1.5.0",
        "@earendil-works/pi-telemetry": "~1.5.0",
        "@hamlet/actor": ">=2.3.28 <2.4.0 || ^3.0.0"
    },
    "devDependencies": {
        "@earendil-works/chord": "1.5.0",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-durable": "1.5.0",
        "@earendil-works/pi-schema": "1.5.0",
        "@earendil-works/pi-telemetry": "1.5.0",
        "@opentelemetry/sdk-node": "0.222.0",
        "@opentelemetry/sdk-trace-node": "2.11.0",
        "@types/node": "^24.0.0",
        "@hamlet/actor": "^3.0.0",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
