{
    "name": "hamlet-node-host",
    "version": "0.1.0",
    "private": true,
    "description": "Hamlet's Node host: TypeScript actors on the native actor module",
    "type": "module",
    "engines": {
        "node": ">=24.1.0"
    },
    "scripts": {
        "check": "tsc --noEmit && biome check --error-on-warnings .",
        "format": "biome check --write ."
