    "dependencies": {
        "@hamlet/actor-node": "file:../../crates/hamlet_actor_node",
        "@hamlet/bare-ts": "npm:@bare-ts/lib@0.7.0",
        "@opentelemetry/api": "1.10.0",
        "cbor-x": "1.6.9",
        "hono": "4.13.18",
        "invariant": "2.2.4",
        "on-change": "6.0.2",
        "pino": "9.14.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@standard-schema/spec": "1.1.0",
        "@types/invariant": "2.2.37",
        "@types/node": "24.19.2",
        "typescript": "7.0.2"
    }
}
