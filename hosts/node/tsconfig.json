{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        // Node loads the host's TypeScript by stripping its types, which
        // refuses syntax that compiles to code.
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src", "test"]
}
