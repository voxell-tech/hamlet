// A round stone tower: stones laid along a circle, each along its edge,
// and the ring repeated course upon course, each stone turned a little
// its own way. Change its radius, how close its stones sit or its courses
// in the parameters.
(
    entry: "stone_tower",
    sheets: {
        "stone_tower": (
            graph: (
                inputs: [
                    (name: "radius", value_type: Number, default: Some(Number(1.4))),
                    (name: "stone_spacing", value_type: Number, default: Some(Number(0.62))),
                    (name: "courses", value_type: Integer, default: Some(Integer(8))),
                ],
                nodes: [
                    (id: 1, does: Kind("transform"), settings: {"scale": Fixed(Point((0.62, 0.28, 0.4)))}),
                    (id: 2, does: Kind("object"), settings: {"asset": Fixed(Choice("quoin"))}),
                    (id: 3, does: Kind("circle"), settings: {"radius": FromParent("radius")}),
                    (id: 4, does: Kind("along_curve"), settings: {"spacing": FromParent("stone_spacing"), "align": Fixed(Bool(true))}),
                    (id: 5, does: Kind("repeat"), settings: {"count": FromParent("courses"), "step": Fixed(Point((0.0, 0.3, 0.0)))}),
                    (id: 6, does: Kind("random"), settings: {"low": Fixed(Number(-3.0)), "high": Fixed(Number(3.0))}),
                    (id: 7, does: Kind("point"), settings: {"x": Fixed(Number(0.0)), "z": Fixed(Number(0.0))}),
                    (id: 8, does: Kind("transform")),
                    (id: 9, does: Kind("matmul")),
                ],
                wires: [
                    (from: (node: 1, name: "transform"), to: (node: 2, name: "transform")),
                    (from: (node: 2, name: "objects"), to: (node: 4, name: "objects")),
                    (from: (node: 3, name: "curve"), to: (node: 4, name: "curve")),
                    (from: (node: 4, name: "objects"), to: (node: 5, name: "objects")),
                    (from: (node: 6, name: "field"), to: (node: 7, name: "y")),
                    (from: (node: 7, name: "point"), to: (node: 8, name: "rotation")),
                    (from: (node: 5, name: "objects"), to: (node: 9, name: "objects")),
                    (from: (node: 8, name: "transform"), to: (node: 9, name: "transform")),
                ],
            ),
            groups: [
                (title: "Stones laid along a circle, each along its edge", nodes: [1, 2, 3, 4]),
                (title: "The ring repeated course upon course", nodes: [5]),
                (title: "Each stone turned a little, its own way", nodes: [6, 7, 8, 9]),
            ],
        ),
    },
)
