// A fence: posts spaced along a line, each leaning a little by chance,
// and two rails across them. Change its length, the spacing of its posts
// or its height in the parameters.
(
    entry: "fence",
    sheets: {
        "fence": (
            graph: (
                inputs: [
                    (name: "length", value_type: Number, default: Some(Number(6.0))),
                    (name: "post_spacing", value_type: Number, default: Some(Number(1.5))),
                    (name: "height", value_type: Number, default: Some(Number(1.1))),
                ],
                nodes: [
                    (id: 1, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "a": FromParent("length"), "b": Fixed(Number(0.5))}),
                    (id: 2, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(-1.0))}),
                    (id: 3, does: Kind("point"), settings: {"y": Fixed(Number(0.0)), "z": Fixed(Number(0.0))}),
                    (id: 4, does: Kind("point"), settings: {"y": Fixed(Number(0.0)), "z": Fixed(Number(0.0))}),
                    (id: 5, does: Kind("line")),
                    (id: 6, does: Kind("along_curve"), settings: {"spacing": FromParent("post_spacing"), "align": Fixed(Bool(false))}),
                    (id: 7, does: Kind("random_transform"), settings: {"turn_low": Fixed(Point((0.0, 0.0, -3.0))), "turn_high": Fixed(Point((0.0, 0.0, 3.0)))}),
                    (id: 8, does: Kind("matmul")),
                    (id: 9, does: Kind("point"), settings: {"x": Fixed(Number(0.12)), "y": FromParent("height"), "z": Fixed(Number(0.12))}),
                    (id: 10, does: Kind("object"), settings: {"asset": Fixed(Choice("post_timber"))}),
                    (id: 11, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("length"), "b": Fixed(Number(0.2))}),
                    (id: 12, does: Kind("point"), settings: {"y": Fixed(Number(0.08)), "z": Fixed(Number(0.05))}),
                    (id: 13, does: Kind("transform"), settings: {"translation": Fixed(Point((0.0, 0.35, 0.08)))}),
                    (id: 14, does: Kind("math"), settings: {"op": Fixed(Choice("subtract")), "a": FromParent("height"), "b": Fixed(Number(0.3))}),
                    (id: 15, does: Kind("point"), settings: {"x": Fixed(Number(0.0)), "z": Fixed(Number(0.08))}),
                    (id: 16, does: Kind("transform")),
                    (id: 17, does: Kind("merge")),
                    (id: 18, does: Kind("object"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 19, does: Kind("combine")),
                ],
                wires: [
                    (from: (node: 1, name: "value"), to: (node: 2, name: "a")),
                    (from: (node: 2, name: "value"), to: (node: 3, name: "x")),
                    (from: (node: 1, name: "value"), to: (node: 4, name: "x")),
                    (from: (node: 3, name: "point"), to: (node: 5, name: "from")),
                    (from: (node: 4, name: "point"), to: (node: 5, name: "to")),
                    (from: (node: 5, name: "curve"), to: (node: 6, name: "curve")),
                    (from: (node: 6, name: "transforms"), to: (node: 7, name: "for")),
                    (from: (node: 6, name: "transforms"), to: (node: 8, name: "a")),
                    (from: (node: 7, name: "transforms"), to: (node: 8, name: "b")),
                    (from: (node: 8, name: "transforms"), to: (node: 10, name: "transform")),
                    (from: (node: 9, name: "point"), to: (node: 10, name: "scale")),
                    (from: (node: 11, name: "value"), to: (node: 12, name: "x")),
                    (from: (node: 12, name: "point"), to: (node: 13, name: "scale")),
                    (from: (node: 14, name: "value"), to: (node: 15, name: "y")),
                    (from: (node: 15, name: "point"), to: (node: 16, name: "translation")),
                    (from: (node: 12, name: "point"), to: (node: 16, name: "scale")),
                    (from: (node: 13, name: "transforms"), to: (node: 17, name: "first")),
                    (from: (node: 16, name: "transforms"), to: (node: 17, name: "second")),
                    (from: (node: 17, name: "transforms"), to: (node: 18, name: "transform")),
                    (from: (node: 10, name: "objects"), to: (node: 19, name: "a")),
                    (from: (node: 18, name: "objects"), to: (node: 19, name: "b")),
                ],
            ),
            groups: [
                (title: "The line the fence runs along", nodes: [1, 2, 3, 4, 5]),
                (title: "Posts along it, each leaning a little", nodes: [6, 7, 8, 9, 10]),
                (title: "Two rails across the front of the posts", nodes: [11, 12, 13, 14, 15, 16, 17, 18]),
            ],
        ),
    },
)
