// A garden bed: flowers on a grid, each kept by chance and turned and
// sized a little differently, in a border of stones laid along a
// rectangle. Change the chance a flower grows in the parameters.
(
    entry: "garden_bed",
    sheets: {
        "garden_bed": (
            graph: (
                inputs: [
                    (name: "chance", value_type: Number, default: Some(Number(0.45))),
                ],
                nodes: [
                    (id: 1, does: Kind("grid"), settings: {"columns": Fixed(Integer(8)), "rows": Fixed(Integer(5)), "spacing": Fixed(Number(0.4))}),
                    (id: 2, does: Kind("random"), settings: {"low": Fixed(Number(0.0)), "high": Fixed(Number(1.0))}),
                    (id: 3, does: Kind("math"), settings: {"op": Fixed(Choice("less")), "b": FromParent("chance")}),
                    (id: 4, does: Kind("cull")),
                    (id: 5, does: Kind("random_transform"), settings: {"turn_high": Fixed(Point((0.0, 360.0, 0.0))), "scale_low": Fixed(Point((0.7, 0.7, 0.7))), "scale_high": Fixed(Point((1.2, 1.2, 1.2)))}),
                    (id: 6, does: Kind("matmul")),
                    (id: 7, does: Kind("object"), settings: {"asset": Fixed(Choice("flower_box")), "scale": Fixed(Point((0.22, 0.3, 0.22)))}),
                    (id: 8, does: Kind("rectangle"), settings: {"width": Fixed(Number(3.6)), "depth": Fixed(Number(2.4))}),
                    (id: 9, does: Kind("along_curve"), settings: {"spacing": Fixed(Number(0.45)), "align": Fixed(Bool(true))}),
                    (id: 10, does: Kind("object"), settings: {"asset": Fixed(Choice("flagstone")), "scale": Fixed(Point((0.42, 0.12, 0.22)))}),
                ],
                wires: [
                    (from: (node: 2, name: "field"), to: (node: 3, name: "a")),
                    (from: (node: 1, name: "transforms"), to: (node: 4, name: "transforms")),
                    (from: (node: 3, name: "value"), to: (node: 4, name: "keep")),
                    (from: (node: 4, name: "transforms"), to: (node: 5, name: "for")),
                    (from: (node: 4, name: "transforms"), to: (node: 6, name: "a")),
                    (from: (node: 5, name: "transforms"), to: (node: 6, name: "b")),
                    (from: (node: 6, name: "transforms"), to: (node: 7, name: "transform")),
                    (from: (node: 8, name: "curve"), to: (node: 9, name: "curve")),
                    (from: (node: 9, name: "transforms"), to: (node: 10, name: "transform")),
                ],
            ),
            groups: [
                (title: "Flowers on a grid, each kept by chance", nodes: [1, 2, 3, 4, 5, 6, 7]),
                (title: "A border of stones round the bed", nodes: [8, 9, 10]),
            ],
        ),
    },
)
