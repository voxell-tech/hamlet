                    (id: 9, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("width"), "b": Fixed(Number(0.26))}),
                    (id: 10, does: Kind("point"), settings: {"y": Fixed(Number(0.07)), "z": Fixed(Number(0.18))}),
