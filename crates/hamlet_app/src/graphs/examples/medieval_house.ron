                    (id: 3, does: Kind("put"), settings: {"asset": Fixed(Choice("window"))}),
                    (id: 4, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("width"), "b": Fixed(Number(0.14))}),
                    (id: 5, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("height"), "b": Fixed(Number(0.14))}),
                    (id: 6, does: Kind("point"), settings: {"z": Fixed(Number(0.08))}),
                    (id: 7, does: Kind("spot"), settings: {"at": Fixed(Point((0.0, -0.07, -0.03)))}),
