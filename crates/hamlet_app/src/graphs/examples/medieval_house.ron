// A timber-framed house built from three graphs of its own. "wall" is a
// plaster panel framed by posts evenly spaced along it, each leaning a
// little, and a rail at its foot and head. "roof" is two tiled slopes
// and a ridge beam, worked out from a width, a depth and a rise.
// "window" is a pane in a frame over a stone sill. "house" puts four
// walls on each storey, the roof on top, windows along the front and a
// flower box under some upper windows, by chance.
(
    entry: "house",
    sheets: {
        "wall": (
            graph: (
                inputs: [
                    (name: "length", value_type: Number, default: Some(Number(5.6))),
                    (name: "height", value_type: Number, default: Some(Number(2.3))),
                    (name: "spacing", value_type: Number, default: Some(Number(1.0))),
                ],
                outputs: [(name: "geometry", value_type: Geometry, from: (node: 25, name: "geometry"))],
                nodes: [
                    (id: 1, does: Kind("point"), settings: {"x": FromParent("length"), "y": FromParent("height"), "z": Fixed(Number(0.16))}),
                    (id: 2, does: Kind("box")),
                    (id: 3, does: Kind("instance"), settings: {"asset": Fixed(Choice("wall_plaster"))}),
                    (id: 4, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length"), "b": Fixed(Number(2.0))}),
                    (id: 5, does: Kind("math"), settings: {"op": Fixed(Choice("subtract"))}),
                    (id: 6, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 7, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 8, does: Kind("line")),
                    (id: 9, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length"), "b": FromParent("spacing")}),
                    (id: 10, does: Kind("math"), settings: {"op": Fixed(Choice("round"))}),
                    (id: 11, does: Kind("math"), settings: {"op": Fixed(Choice("max")), "b": Fixed(Number(1.0))}),
                    (id: 12, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length")}),
                    (id: 13, does: Kind("along_curve")),
                    (id: 14, does: Kind("transform"), settings: {"roll": Random((spread: Range(-2.0, 2.0), scope: Placement))}),
                    (id: 15, does: Kind("point"), settings: {"x": Fixed(Number(0.16)), "y": FromParent("height"), "z": Fixed(Number(0.14))}),
                    (id: 16, does: Kind("instance"), settings: {"asset": Fixed(Choice("post_timber"))}),
                    (id: 17, does: Kind("math"), settings: {"op": Fixed(Choice("subtract")), "a": FromParent("height"), "b": Fixed(Number(0.14))}),
                    (id: 18, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 19, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("length"), "b": Fixed(Number(0.16))}),
                    (id: 20, does: Kind("point"), settings: {"y": Fixed(Number(0.14)), "z": Fixed(Number(0.14))}),
                    (id: 21, does: Kind("box")),
                    (id: 22, does: Kind("instance"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 23, does: Kind("box"), settings: {"at": Fixed(Point((0.0, 0.0, 0.1)))}),
                    (id: 24, does: Kind("instance"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 25, does: Kind("join")),
                ],
                wires: [
                    (from: (node: 1, name: "point"), to: (node: 2, name: "size")),
                    (from: (node: 2, name: "placements"), to: (node: 3, name: "placements")),
