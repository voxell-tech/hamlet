// A timber-framed house built from three graphs of its own. "wall" is a
// plaster panel with a post copied evenly along it, each leaning a
// little, and a rail repeated at its foot and head. "roof" is two tiled
// slopes and a ridge beam, worked out from a width, a depth and a rise;
// left unset, the rise varies from house to house. "window" is a pane in
// a frame over a stone sill. "house" moves four walls into place on each
// storey, the roof on top, copies windows along the front, and a flower
// box under some upper windows, by chance.
(
    entry: "house",
    sheets: {
        "wall": (
            graph: (
                inputs: [
                    (name: "length", value_type: Number, default: Some(Number(5.6))),
                    (name: "height", value_type: Number, default: Some(Number(2.3))),
                    (name: "spacing", value_type: Number, default: Some(Number(1.0))),
                ],
                outputs: [(name: "objects", value_type: Objects, from: (node: 28, name: "objects"))],
                nodes: [
                    (id: 1, does: Kind("point"), settings: {"x": FromParent("length"), "y": FromParent("height"), "z": Fixed(Number(0.16))}),
                    (id: 2, does: Kind("transform")),
                    (id: 3, does: Kind("object"), settings: {"asset": Fixed(Choice("wall_plaster"))}),
                    (id: 4, does: Kind("point"), settings: {"x": Fixed(Number(0.16)), "y": FromParent("height"), "z": Fixed(Number(0.14))}),
                    (id: 5, does: Kind("transform")),
                    (id: 6, does: Kind("object"), settings: {"asset": Fixed(Choice("post_timber"))}),
                    (id: 7, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "a": FromParent("length"), "b": Fixed(Number(0.5))}),
                    (id: 8, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(-1.0))}),
                    (id: 9, does: Kind("point"), settings: {"y": Fixed(Number(0.0)), "z": Fixed(Number(0.1))}),
                    (id: 10, does: Kind("point"), settings: {"y": Fixed(Number(0.0)), "z": Fixed(Number(0.1))}),
                    (id: 11, does: Kind("line")),
                    (id: 12, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length"), "b": FromParent("spacing")}),
                    (id: 13, does: Kind("math"), settings: {"op": Fixed(Choice("round"))}),
                    (id: 14, does: Kind("math"), settings: {"op": Fixed(Choice("max")), "b": Fixed(Number(1.0))}),
                    (id: 15, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length")}),
                    (id: 16, does: Kind("along_curve"), settings: {"align": Fixed(Bool(false))}),
                    (id: 17, does: Kind("random"), settings: {"low": Fixed(Number(-2.0)), "high": Fixed(Number(2.0))}),
                    (id: 18, does: Kind("point"), settings: {"x": Fixed(Number(0.0)), "y": Fixed(Number(0.0))}),
                    (id: 19, does: Kind("transform")),
                    (id: 20, does: Kind("matmul")),
                    (id: 21, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("length"), "b": Fixed(Number(0.16))}),
                    (id: 22, does: Kind("point"), settings: {"y": Fixed(Number(0.14)), "z": Fixed(Number(0.14))}),
                    (id: 23, does: Kind("transform"), settings: {"translation": Fixed(Point((0.0, 0.0, 0.1)))}),
                    (id: 24, does: Kind("object"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 25, does: Kind("math"), settings: {"op": Fixed(Choice("subtract")), "a": FromParent("height"), "b": Fixed(Number(0.14))}),
                    (id: 26, does: Kind("point"), settings: {"x": Fixed(Number(0.0)), "z": Fixed(Number(0.0))}),
                    (id: 27, does: Kind("repeat"), settings: {"count": Fixed(Integer(2))}),
                    (id: 28, does: Kind("combine")),
                ],
                wires: [
                    (from: (node: 1, name: "point"), to: (node: 2, name: "scale")),
                    (from: (node: 2, name: "transform"), to: (node: 3, name: "transform")),
