// A timber-framed house built from three graphs of its own. "wall" is a
// plaster panel framed by posts evenly spaced along it, each leaning a
// little, and a rail at its foot and head. "roof" is two tiled slopes
// and a ridge beam, worked out from a width, a depth and a rise; left
// unset, the rise varies from house to house.
// "window" is a pane in a frame over a stone sill. "house" puts four
// walls on each storey, the roof on top, windows along the front and a
// flower box under some upper windows, by chance. Each graph's nodes
// are grouped by the part they make.
(
    entry: "house",
    sheets: {
        "wall": (
            graph: (
                inputs: [
                    (name: "length", value_type: Number, default: Some(Number(5.6))),
                    (name: "height", value_type: Number, default: Some(Number(2.3))),
                    (name: "spacing", value_type: Number, default: Some(Number(1.0))),
                ],
                outputs: [(name: "geometry", value_type: Geometry, from: (node: 25, name: "geometry"))],
                nodes: [
                    (id: 1, does: Kind("point"), settings: {"x": FromParent("length"), "y": FromParent("height"), "z": Fixed(Number(0.16))}),
                    (id: 2, does: Kind("spot")),
                    (id: 3, does: Kind("put"), settings: {"asset": Fixed(Choice("wall_plaster"))}),
                    (id: 4, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length"), "b": Fixed(Number(2.0))}),
                    (id: 5, does: Kind("math"), settings: {"op": Fixed(Choice("subtract"))}),
                    (id: 6, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 7, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 8, does: Kind("line")),
                    (id: 9, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length"), "b": FromParent("spacing")}),
                    (id: 10, does: Kind("math"), settings: {"op": Fixed(Choice("round"))}),
                    (id: 11, does: Kind("math"), settings: {"op": Fixed(Choice("max")), "b": Fixed(Number(1.0))}),
                    (id: 12, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("length")}),
                    (id: 13, does: Kind("along_curve")),
                    (id: 14, does: Kind("transform")),
                    (id: 15, does: Kind("point"), settings: {"x": Fixed(Number(0.16)), "y": FromParent("height"), "z": Fixed(Number(0.14))}),
                    (id: 16, does: Kind("put"), settings: {"asset": Fixed(Choice("post_timber"))}),
                    (id: 17, does: Kind("math"), settings: {"op": Fixed(Choice("subtract")), "a": FromParent("height"), "b": Fixed(Number(0.14))}),
                    (id: 18, does: Kind("point"), settings: {"z": Fixed(Number(0.1))}),
                    (id: 19, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("length"), "b": Fixed(Number(0.16))}),
                    (id: 20, does: Kind("point"), settings: {"y": Fixed(Number(0.14)), "z": Fixed(Number(0.14))}),
                    (id: 21, does: Kind("spot")),
                    (id: 22, does: Kind("put"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 23, does: Kind("spot"), settings: {"at": Fixed(Point((0.0, 0.0, 0.1)))}),
                    (id: 24, does: Kind("put"), settings: {"asset": Fixed(Choice("beam_timber"))}),
                    (id: 25, does: Kind("join")),
                    (id: 26, does: Kind("random"), settings: {"low": Fixed(Number(-2.0)), "high": Fixed(Number(2.0))}),
                ],
                wires: [
                    (from: (node: 26, name: "field"), to: (node: 14, name: "roll")),
                    (from: (node: 1, name: "point"), to: (node: 2, name: "size")),
                    (from: (node: 2, name: "spots"), to: (node: 3, name: "spots")),
                    (from: (node: 4, name: "value"), to: (node: 5, name: "b")),
                    (from: (node: 5, name: "value"), to: (node: 6, name: "x")),
                    (from: (node: 4, name: "value"), to: (node: 7, name: "x")),
                    (from: (node: 6, name: "point"), to: (node: 8, name: "from")),
                    (from: (node: 7, name: "point"), to: (node: 8, name: "to")),
                    (from: (node: 9, name: "value"), to: (node: 10, name: "a")),
                    (from: (node: 10, name: "value"), to: (node: 11, name: "a")),
                    (from: (node: 11, name: "value"), to: (node: 12, name: "b")),
                    (from: (node: 8, name: "curve"), to: (node: 13, name: "curve")),
                    (from: (node: 12, name: "value"), to: (node: 13, name: "spacing")),
                    (from: (node: 13, name: "spots"), to: (node: 14, name: "spots")),
                    (from: (node: 14, name: "spots"), to: (node: 16, name: "spots")),
                    (from: (node: 15, name: "point"), to: (node: 16, name: "size")),
                    (from: (node: 17, name: "value"), to: (node: 18, name: "y")),
                    (from: (node: 19, name: "value"), to: (node: 20, name: "x")),
                    (from: (node: 18, name: "point"), to: (node: 21, name: "at")),
                    (from: (node: 20, name: "point"), to: (node: 21, name: "size")),
                    (from: (node: 21, name: "spots"), to: (node: 22, name: "spots")),
                    (from: (node: 20, name: "point"), to: (node: 23, name: "size")),
                    (from: (node: 23, name: "spots"), to: (node: 24, name: "spots")),
                    (from: (node: 3, name: "geometry"), to: (node: 25, name: "a")),
                    (from: (node: 16, name: "geometry"), to: (node: 25, name: "b")),
                    (from: (node: 22, name: "geometry"), to: (node: 25, name: "c")),
                    (from: (node: 24, name: "geometry"), to: (node: 25, name: "d")),
                ],
            ),
            groups: [
                (title: "Plaster panel", nodes: [1, 2, 3]),
                (title: "Where the posts go", nodes: [4, 5, 6, 7, 8, 9, 10, 11, 12]),
                (title: "Leaning posts", nodes: [13, 14, 15, 16, 26]),
                (title: "Rails, foot and head", nodes: [17, 18, 19, 20, 21, 22, 23, 24]),
            ],
        ),
        "roof": (
            graph: (
                inputs: [
                    (name: "width", value_type: Number, default: Some(Number(7.0))),
                    (name: "depth", value_type: Number, default: Some(Number(4.4))),
                    (name: "rise", value_type: Number, default: Some(Number(2.2)),
                     vary: Some((low: 1.8, high: 2.8, per: House))),
                ],
                outputs: [(name: "geometry", value_type: Geometry, from: (node: 24, name: "geometry"))],
                nodes: [
                    (id: 1, does: Kind("math"), settings: {"op": Fixed(Choice("divide")), "a": FromParent("depth"), "b": Fixed(Number(2.0))}),
                    (id: 2, does: Kind("math"), settings: {"op": Fixed(Choice("hypot")), "b": FromParent("rise")}),
                    (id: 3, does: Kind("math"), settings: {"op": Fixed(Choice("angle")), "a": FromParent("rise")}),
                    (id: 4, does: Kind("math"), settings: {"op": Fixed(Choice("subtract"))}),
                    (id: 5, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "a": FromParent("rise"), "b": Fixed(Number(0.5))}),
                    (id: 6, does: Kind("math"), settings: {"op": Fixed(Choice("multiply")), "b": Fixed(Number(0.5))}),
                    (id: 7, does: Kind("math"), settings: {"op": Fixed(Choice("subtract"))}),
                    (id: 8, does: Kind("point")),
                    (id: 9, does: Kind("point")),
                    (id: 10, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "b": Fixed(Number(0.5))}),
                    (id: 11, does: Kind("point"), settings: {"x": FromParent("width"), "y": Fixed(Number(0.16))}),
                    (id: 12, does: Kind("spot")),
                    (id: 13, does: Kind("transform")),
                    (id: 14, does: Kind("put"), settings: {"asset": Fixed(Choice("roof_tiles"))}),
                    (id: 15, does: Kind("spot")),
                    (id: 16, does: Kind("transform")),
                    (id: 17, does: Kind("put"), settings: {"asset": Fixed(Choice("roof_tiles"))}),
                    (id: 18, does: Kind("math"), settings: {"op": Fixed(Choice("add")), "a": FromParent("width"), "b": Fixed(Number(0.3))}),
                    (id: 19, does: Kind("math"), settings: {"op": Fixed(Choice("subtract")), "a": FromParent("rise"), "b": Fixed(Number(0.08))}),
                    (id: 20, does: Kind("point")),
