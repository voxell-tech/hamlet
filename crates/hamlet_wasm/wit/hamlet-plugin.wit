package hamlet:plugin@0.1.0;

interface host {
  enum level { info, warn, error }

  log: func(level: level, message: string);

  // Adds a panel to the dock. Only `entry` declares; a call at any other
  // time is dropped. `icon` names a glyph of the panels' icon family.
  panel: func(id: string, title: string, icon: string);
}

interface plugin {
  variant incoming {
    tick(u64),
  }

  variant intent {
    log-line(string),
  }

  record outgoing {
    intents: list<intent>,
  }

  entry: func();

  step: func(inbox: list<incoming>) -> outgoing;
}

world hamlet {
  import host;
  export plugin;
}
