package hamlet:plugin@0.1.0;

interface host {
  enum level { info, warn, error }

  log: func(level: level, message: string);

  // Adds a panel to the dock. Only `entry` declares; a call at any other
  // time is dropped. `icon` names a glyph of the panels' icon family.
  panel: func(id: string, title: string, icon: string);

  record agent {
    name: string,
    hamlet: string,
  }

  // The living agents, each with its hamlet: a copy. It needs the
  // capability `read.agents`; without it the error is
  // "read.agents not granted", and if the manifest names it and the
  // chief has not decided, the chief is asked. A grant taken back
  // applies to the next call.
  agents: func() -> result<list<agent>, string>;

  // What the selected agent keeps: its notes, its character and the
  // names of its skills. All are empty while no agent is selected.
  record agent-papers {
    notes: string,
    character: string,
    skills: list<string>,
  }

  // The selected agent's papers: a copy. It needs the capability
  // `read.papers`, and is gated as `agents` is.
  papers: func() -> result<agent-papers, string>;

  // A place in the world, in metres: `x` and `z` along the ground
  // and `y` up.
  record place {
    x: f32,
    y: f32,
    z: f32,
  }

  // A hamlet by its id, the name of its folder, which a scope names
  // it by; the name the window shows; and the place of its common
  // while its town is drawn.
  record world-hamlet {
    id: string,
    name: string,
    at: option<place>,
  }

  // A living agent, the id of its hamlet, the place of its robot
  // while it is drawn, and whether it is at work.
  record world-agent {
    name: string,
    hamlet: string,
    at: option<place>,
    busy: bool,
  }

  // The thing selected in the world: its kind, as a `context-item`
  // names kinds, and the name of the agent or the chief, or the id of
  // the hamlet.
  record world-thing {
    kind: string,
    name: string,
  }

  record world-view {
    hamlets: list<world-hamlet>,
    agents: list<world-agent>,
    selected: option<world-thing>,
    // The hour the sky shows, 0 to 24.
    hour: f32,
  }

  // The realm as it is now: a copy, with places to a tenth of a
  // metre, and at most as many hamlets and agents as the host caps.
  // It needs the capability `read.world`, and is gated as `agents`
  // is.
  survey: func() -> result<world-view, string>;

  // Declares a command the plugin exports, which other plugins may run
  // by `id` once its manifest lists it under `exports.commands`, and
  // the chief runs from a menu or a key. Only `entry` declares; a call
  // at any other time is dropped. `title` is what a menu or a key
  // shows for it, and `icon` optionally names a glyph of the panels'
  // icon family.
  command: func(id: string, title: string, icon: option<string>);

  // Adds a line to a menu of the top bar that runs `command`, one of
  // the commands this plugin declared. `menu` is `hamlet` or `view`.
  // Lines are grouped by `section`, in order, with a line between
  // groups, and within a section ordered by label. It needs the
  // capability `ui.menu`: the line shows only while the chief allows
  // it, and the chief is asked where that is yet to be decided. Only
  // `entry` declares.
  menu-item: func(menu: string, section: u32, label: string, command: string);

  // Binds a shortcut such as `Cmd+Shift+N` to `command`, one of the
  // commands this plugin declared. `Cmd` is the command key of a Mac
  // and Control elsewhere. It needs the capability `ui.keys`, and is
  // gated as `menu-item` is. A chord that a built-in shortcut uses
  // never runs this plugin's command, and one that another plugin uses
  // too runs neither. Escape and Enter are not shortcut keys. Only
  // `entry` declares.
  key: func(chord: string, command: string);

  // Adds an item to the menu a right click opens on a thing of the
  // world of kind `target`: `agent`, `house`, `mayor`, `ruin`,
  // `hamlet`, `chief`, `hearth`, `library` or `ground`. It runs
  // `command`, one of the commands this plugin declared, which is
  // given the thing as its arguments: a `subject` of
  // `hamlet_guest`, written with postcard, from the sender `chief`.
  // Items are ordered by `section`, then by label. `label` may hold
  // `{name}`, the thing's name. It needs the capability `ui.context`,
  // and is gated as `menu-item` is. Only `entry` declares.
  context-item: func(target: string, section: u32, label: string, command: string);

  // Adds a tab to the Inspector's page of the things of kind `target`,
  // which is `agent` for now, whose page is the plugin's own panel
  // `panel`, by the id it gave it with `panel`. The tab takes the
  // panel's icon. The plugin learns which agent is selected from the
  // host event `selection-changed`, and draws the panel again. It
  // needs the capability `ui.inspector`, and is gated as `menu-item`
  // is. Only `entry` declares.
  inspector-section: func(target: string, title: string, panel: string);

  // Adds a door to the Settings panel, with `title` and the glyph
  // `icon` of the panels' icon family, to a page that is the plugin's
  // own panel `panel`, by the id it gave it with `panel`. It needs the
  // capability `ui.settings`, and is gated as `menu-item` is. Only
  // `entry` declares.
  settings-page: func(title: string, icon: string, panel: string);

  enum field-kind { text, number, flag }

  // One argument of an agent tool.
  record tool-field {
    name: string,
    kind: field-kind,
    description: string,
    required: bool,
  }

  // Gives the agents a tool called `name`. An agent that calls it has
  // the call reach the plugin as a `command` of that name from the
  // sender `agent`, with its arguments as a `tool-args` of
  // `hamlet_guest` written with postcard, and the plugin answers
  // with a `reply` whose bytes are the text the agent is shown. The
  // agent is told the text is from this plugin and is data, not an
  // instruction. It needs the capability `agent.tool`, whose ask may
  // list the hamlets that are offered the tool (none lists every
  // hamlet), and it is gated as `menu-item` is. A plugin with this
  // capability may not also hold `chat.send`, `commands.run` or
  // `plugin.use`, so a tool call never carries the chief's
  // authority. Only `entry` declares.
  agent-tool: func(name: string, description: string, fields: list<tool-field>);

  // The standing answer to a `request`.
  enum request-result {
    // The plugin may use the capability.
    granted,
    // The plugin may not: the chief said no, or the manifest does not
    // name the capability.
    denied,
    // The chief has been asked. The answer comes later, in the inbox,
    // as `granted` or `denied`.
    pending,
  }

  // Asks to use a capability the manifest names, giving a reason. A
  // capability the manifest does not name is `denied` and nobody is
  // asked.
  request: func(capability: string, reason: string) -> request-result;

  // The plugin's own store of keys and values, kept on disk and
  // private to it. It needs no capability. A key is 1 to a few dozen
  // characters of a-z, 0-9, `.`, `_` and `-`, not starting with `.`.
  // A value over a cap, a key over a cap or a bad key is an error;
  // the caps are the host's.

  // The value of `key`, if it is there.
  storage-get: func(key: string) -> option<list<u8>>;

  // Sets `key`, replacing its value.
  storage-set: func(key: string, value: list<u8>) -> result<_, string>;

  // Removes `key`, if it is there.
  storage-delete: func(key: string);

  // The keys that start with `prefix`, in order.
  storage-keys: func(prefix: string) -> list<string>;

  // The plugin's own folder of files, which the host keeps for it and
  // no other plugin or path outside it can reach. A path is relative,
  // of names of letters, digits, `.`, `_`, `-` and spaces joined by
  // `/`, none starting with `.`; a link is never followed. The host
  // caps the files, the bytes and the length of a path. The calls need
  // the capabilities `files.read` and `files.write`, are gated as
  // `agents` is, and fail with `<name> not granted` or why the path or
  // the cap does not allow it.

  // The paths of the files, in order. It needs `files.read`.
  files-list: func() -> result<list<string>, string>;

  // The bytes of the file at `path`. It needs `files.read`.
  files-read: func(path: string) -> result<list<u8>, string>;

  // Sets the file at `path`, creating the folders on the way. It
  // needs `files.write`.
  files-write: func(path: string, data: list<u8>) -> result<_, string>;

  // Removes the file at `path`, if it is there. It needs
  // `files.write`.
  files-delete: func(path: string) -> result<_, string>;

  // The plugin's own database, which the host keeps for it and no
  // other plugin can reach. It holds named tables of records. A table
  // is 1 to a few dozen characters of a-z, 0-9, `_` and `-`, and is
  // there once it holds a record. A record is an id, bytes the host
  // does not read and a few fields, each a name and a value, that
  // `db-find` looks records up by. Records are in the order of their
  // ids. The host caps the tables, the records of a table, the bytes
  // of a record, the fields, the bytes of the whole database and the
  // records of a page. The calls need the capability `db`, are gated
  // as `agents` is, and fail with `db not granted` or why a name or a
  // cap does not allow it. A plugin shares records with another
  // through a collection, not through the database.
  record db-field {
    name: string,
    value: string,
  }

  record db-record {
    id: string,
    bytes: list<u8>,
    fields: list<db-field>,
  }

  record db-page {
    records: list<db-record>,
    // The id to give as `after` for the next page, when there is one.
    next: option<string>,
  }

  // Sets the record `id` of `table`, replacing it.
  db-put: func(table: string, id: string, bytes: list<u8>, fields: list<db-field>) -> result<_, string>;

  // The record `id` of `table`, if it is there.
  db-get: func(table: string, id: string) -> result<option<db-record>, string>;

  // Removes the record `id` of `table`, if it is there.
  db-delete: func(table: string, id: string) -> result<_, string>;

  // A page of `table`, from the first id after `after`. The host caps
  // the records and the bytes of a page, and `limit` may lower the
  // records.
  db-list: func(table: string, after: option<string>, limit: u32) -> result<db-page, string>;

  // A page of the records of `table` whose field `field` is `value`,
  // as `db-list` pages.
  db-find: func(table: string, field: string, value: string, after: option<string>, limit: u32) -> result<db-page, string>;

  // A collection another plugin shares: the keys of its storage that
  // start with a prefix its manifest names under `exports.collections`.
  // The manifest of this plugin lists it under `imports.collections`
  // as `plugin/name`, and the capability `collections.read` or
  // `collections.write` is chosen for that. Every call returns copies,
  // and a failure is `plugin/name is not in the manifest's imports`,
  // `collections.read not granted` (the chief is asked where the
  // choice is yet to be made), `plugin/name is not there`, or, for a
  // write, `plugin/name is read-only`. Keys are those of the
  // collection, without the prefix.
  record collection-item {
    key: string,
    value: list<u8>,
  }

  record collection-page {
    items: list<collection-item>,
    // The key to give as `after` for the next page, when there is one.
    next: option<string>,
  }

  // A page of the collection, in the order of the keys, from the
  // first key after `after`. The host caps the items and the bytes of
  // a page, and `limit` may lower the items.
  collection-list: func(plugin: string, name: string, after: option<string>, limit: u32) -> result<collection-page, string>;

  // The value of `key`, if it is there.
  collection-get: func(plugin: string, name: string, key: string) -> result<option<list<u8>>, string>;

  // Sets `key`, which needs `collections.write` and a collection that
  // is `writable`. The plugin that shares it is told that the
  // collection changed.
  collection-put: func(plugin: string, name: string, key: string, value: list<u8>) -> result<_, string>;

  // Removes `key`, under the same conditions as `collection-put`.
  collection-delete: func(plugin: string, name: string, key: string) -> result<_, string>;

  // A blob the host holds for the plugin in memory. It is kept
  // across a reload and across a disable and enable, and is empty
  // after the host restarts.
  state-get: func() -> list<u8>;

  // Replaces the blob. A blob over the cap is an error.
  state-set: func(state: list<u8>) -> result<_, string>;
}

interface plugin {
  // What reached the plugin. The events name the panel by the id the
  // plugin gave it, and the node by the id the plugin gave the node.
  variant incoming {
    tick(u64),
    click(press),
    toggled(toggle),
    text-changed(typed),
    // The chief let the plugin use the capability it was refused, which
    // is named. It may be for this run only.
    granted(string),
    // The chief did not.
    denied(string),
    // Another plugin, or the chief from a menu or a key, runs a
    // command this plugin declared. It answers with a `reply` intent
    // that names `call-id`.
    command(command-call),
    // The answer to a command this plugin ran.
    reply(call-answer),
    // An event a plugin published, or the host, that this plugin
    // imports under `imports.events` and may use.
    event(published),
    // The answer to a `fetch` this plugin made.
    fetched(fetch-answer),
    // The answer to a `pick-file` this plugin made.
    picked(pick-answer),
    // The answer to a `pick-folder` this plugin made: the name of the
    // folder, never its path.
    folder-picked(pick-answer),
    // The answer to a `folder` call this plugin made.
    folder-done(folder-answer),
  }

  record published {
    topic: string,
    // The id of the plugin that published it, or `host`.
    sender: string,
    // A copy of the payload, in a format the publisher documents.
    payload: list<u8>,
  }

  record command-call {
    // The host's number for the call, which the reply gives back.
    call-id: u64,
    // The id of the plugin that runs the command, or `chief` where the
    // chief ran it: with no arguments from a menu or a key, and with
    // the thing a context item was chosen on from one.
    sender: string,
    command: string,
    // A copy of the arguments, in a format the two plugins agree on.
    args: list<u8>,
  }

  record call-answer {
    // The `call-id` of the call it answers.
    call-id: u64,
    // The bytes the command returns, or why there are none: the plugin
    // is switched off, stopped or not there, the call is not
    // allowed, it was not answered in time, or the command failed.
    outcome: result<list<u8>, string>,
  }

  // A button was pressed.
  record press {
    panel: string,
    id: string,
  }

  // A checkbox was asked to take a state.
  record toggle {
    panel: string,
    id: string,
    on: bool,
  }

  // A text field was committed with Enter or by leaving it.
  record typed {
    panel: string,
    id: string,
    text: string,
  }

  variant intent {
    log-line(string),
    // Draw the panel again, though no event reached it.
    redraw(string),
    // Runs a command of another plugin. The answer reaches a later
    // `step` as `reply`, whatever happened to the call.
    run-command(call-request),
    // Answers a `command` the plugin was given.
    reply(call-answer),
    // Publishes an event the manifest lists under `exports.events`, to
    // every plugin that imports it and holds `plugin.use` for this one.
    publish(publication),
    // Brings one of the plugin's own panels, by the id it gave it, to
    // the front of the dock, opening it if it is closed. It needs no
    // capability. A panel the plugin did not declare is dropped.
    open-panel(string),
    // Sends a message to an agent as the chief. It needs the
    // capability `chat.send`, which is asked at its first use and
    // may be limited to the agents the manifest lists. The message
    // reaches the agent as `[sent by plugin <id>] <text>`, a notice
    // in the open chat tells of it, and the host limits how many a
    // minute. A refused act is dropped with a warning; where the
    // chief is yet to decide, the chief is asked and the answer
    // reaches a later `step` as `granted` or `denied`.
    send-chat(chat-message),
    // Runs the registered command of this id (`plugin/name`) as the
    // chief would, from a menu. It needs the capability
    // `commands.run`, gated, limited and noted in the chat as
    // `send-chat` is, and may be limited to the commands the
    // manifest lists.
    run-as-chief(string),
    // Fetches an address over https with GET or POST. It needs the
    // capability `net`, whose ask in the manifest lists the hosts it
    // may reach in its `scope` (a host such as `api.example.com`, or
    // `host:port` for a port other than 443); an ask with no hosts
    // reaches none. The answer reaches a later `step` as `fetched`,
    // whatever happened. The host follows no redirect, sends no
    // header but the content type, and limits the bytes of the
    // request and of the answer, the time, the requests waiting and
    // the number a minute.
    fetch(fetch-request),
    // Does to a thing of the world what the chief does with a click:
    // focus the camera on it, follow it or select it. It needs the
    // capability `world.act`, which is asked at its first use and
    // reaches only the agents and hamlets of the hamlets its ask
    // lists. It is limited and noted in the chat as `send-chat` is.
    world-act(world-order),
    // Replaces what the plugin draws over the world with these marks;
    // none takes it away. It needs the capability `world.overlay`,
    // allowed when the chief lets the plugin in. The host draws the
    // marks each frame where their anchors are seen, names the plugin
    // in a corner of the world's panel, caps the marks and their text
    // and limits how often a plugin replaces them.
    overlay(list<mark>),
    // Asks the chief for a file in the system's dialog, titled with
    // the plugin's name and `title`. The file the chief picks is
    // copied into the plugin's folder of files, under `picked/`,
    // within that folder's caps, and the answer reaches a later
    // `step` as `picked`: the path in the folder, never one outside
    // it. It needs the capability `fs.pick`. One dialog is open at a
    // time.
    pick-file(pick-request),
    // Asks the chief for a folder to work in, in the system's
    // dialog titled with the plugin's name and `title`. The folder
    // chosen replaces the one the plugin had, and the answer reaches
    // a later `step` as `folder-picked`. It needs the capability
    // `fs.folder`. A folder that holds Hamlet's home, or is inside
    // it, is refused. One dialog is open at a time.
    pick-folder(pick-request),
    // Lists, reads or writes in the folder the chief chose. A path is
    // relative to it; one that leaves it, goes through a link out of
    // it or names what is not a file or a folder is refused. Reading
    // needs `fs.folder` for the folder and writing `fs.folder` for
    // its writes, each chosen apart. A write waits for the chief
    // unless the folder is in the folder of a hamlet set to auto.
    // The answer reaches a later `step` as `folder-done`.
    folder(folder-request),
  }

  record folder-request {
    // The plugin's own number for the call, which the answer names.
    id: u32,
    op: folder-op,
  }

  variant folder-op {
    // The names in the folder at a path, an empty one for the folder
    // itself, in order, each folder's with `/` after it.
    %list(string),
    // The bytes of the file at a path.
    read(string),
    // Sets the file at a path, which may be new, in a folder that is
    // there.
    write(folder-file),
  }

  record folder-file {
    path: string,
    data: list<u8>,
  }

  variant folder-result {
    listed(list<string>),
    read(list<u8>),
    written,
  }

  record folder-answer {
    // The `id` of the call it answers.
    id: u32,
    // What it gave, or why not: no folder was chosen, `fs.folder` is
    // not granted (the chief is asked where it is yet to be
    // decided), the path is refused, a cap was passed, or the chief
    // did not allow the write.
    outcome: result<folder-result, string>,
  }

  record pick-request {
    // The plugin's own number for the ask, which the answer names.
    id: u32,
    title: string,
  }

  record pick-answer {
    // The `id` of the ask it answers.
    id: u32,
    // The path of the copy in the plugin's folder of files, or why
    // there is none: nothing was chosen, `fs.pick` is not granted (the
    // chief is asked where it is yet to be decided), a dialog is
    // already open, or the file is over a cap.
    outcome: result<string, string>,
  }

  // A point of the world in metres, as a `place` of the survey.
  record point {
    x: f32,
    y: f32,
    z: f32,
  }

  // What a mark hangs off: the foot of an agent's robot by the
  // agent's name, a hamlet's common by its id, or a point.
  variant anchor {
    agent(string),
    hamlet(string),
    point(point),
  }

  record mark-size {
    w: f32,
    h: f32,
  }

  // A line to `x`, `y` pixels from where `to` is seen, or from where
  // the mark's own anchor is where it has none.
  record mark-line {
    to: option<anchor>,
    x: f32,
    y: f32,
    width: f32,
  }

  record mark-text {
    text: string,
    size: f32,
  }

  // A rectangle from its corner, a disc of a radius about its
  // middle, a line from its start, or words from their top left.
  variant mark-shape {
    rect(mark-size),
    circle(f32),
    line(mark-line),
    text(mark-text),
  }

  // A shape over the world, `x`, `y` pixels from where its anchor
  // is seen. A mark whose anchor is not in sight is not drawn.
  record mark {
    anchor: anchor,
    x: f32,
    y: f32,
    shape: mark-shape,
    paint: paint,
  }

  // A thing of the world: an agent by its name, a hamlet by its id.
  variant world-target {
    agent(string),
    hamlet(string),
  }

  variant world-order {
    // Brings the thing to the middle of the view and comes in close.
    focus(world-target),
    // As `focus`, and the camera stays on it until the chief slides
    // the ground.
    follow(world-target),
    // Selects it, as a click on it does.
    select(world-target),
  }

  enum http-method { get, post }

  record fetch-request {
    // The plugin's own number for the request, which the answer
    // names. It is not the number of any request still waiting.
    id: u32,
    method: http-method,
    url: string,
    // The content type of a `post` body, or empty.
    content-type: string,
    body: list<u8>,
  }

  record fetch-answer {
    // The `id` of the request it answers.
    id: u32,
    // The answer, whatever its status, or why there is none: the
    // address or the host is not allowed, `net` is not granted (the
    // chief is asked where it is yet to be decided), a limit was
    // passed or the request failed.
    outcome: result<fetch-response, string>,
  }

  record fetch-response {
    status: u16,
    // The content type of the answer, or empty.
    content-type: string,
    body: list<u8>,
  }

  record chat-message {
    // The name of the agent.
    agent: string,
    text: string,
  }

  record publication {
    topic: string,
    payload: list<u8>,
  }

  record call-request {
    // The caller's own number for the call, which is not the number
    // of any of its calls still waiting. The reply names it.
    call-id: u64,
    // The id of the plugin that exports the command.
    plugin: string,
    command: string,
    args: list<u8>,
  }

  record outgoing {
    intents: list<intent>,
  }

  // What one node of a panel is. `heading` and `note` are text in the
  // panels' heading and dim small looks. A `button`, `checkbox` and
  // `text-field` and `text-area` need an id, which names them in
  // events.
  variant widget {
    column,
    row,
    scroll,
    label(string),
    heading(string),
    note(string),
    // The name of a glyph of the panels' icon family.
    icon(string),
    // The label.
    button(string),
    checkbox(checkbox),
    // The text.
    text-field(string),
    divider,
    // A box of several lines to type in, with the text. A change is
    // committed as `text-changed` when focus leaves it or on Ctrl+Enter
    // (Cmd+Enter on a Mac).
    text-area(string),
    // Markdown text, drawn and not editable: headings, emphasis, lists,
    // code and rules. A link is shown as its text.
    markdown(string),
    // A box of a few 2D shapes, drawn first to last. It needs the
    // capability `ui.canvas`, allowed when the chief lets the plugin
    // in; without it the tree is not drawn. No shader and no texture
    // reach it.
    canvas(canvas),
  }

  // What a shape is painted with: a colour of the theme by name (`ink`,
  // `dim`, `faint`, `brass`, `lamp`, `flame`, `ember`, `rune`, `card`,
  // `well`, `panel`, `seam`, `red` or `moss`), which follows the theme,
  // or a colour as 0xRRGGBBAA.
  variant paint {
    palette(string),
    rgba(u32),
  }

  // The positions are pixels from the top left of the canvas.
  record rect-shape {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    paint: paint,
  }

  record line-shape {
    x1: f32,
    y1: f32,
    x2: f32,
    y2: f32,
    width: f32,
    paint: paint,
  }

  // A disc about (x, y).
  record circle-shape {
    x: f32,
    y: f32,
    r: f32,
    paint: paint,
  }

  record text-shape {
    x: f32,
    y: f32,
    text: string,
    // The size of the lettering, in pixels.
    size: f32,
    paint: paint,
  }

  variant shape {
    rect(rect-shape),
    line(line-shape),
    circle(circle-shape),
    text(text-shape),
  }

  // The size of the box in pixels and the shapes in it. What falls
  // outside is cut off. The host caps the size and the number of the
  // shapes of a tree, and the text counts against the text of the
  // tree.
  record canvas {
    width: u32,
    height: u32,
    shapes: list<shape>,
  }

  record checkbox {
    label: string,
    checked: bool,
  }

  // The id is stable across redraws, so that a node is matched with
  // the same node of the last tree among its siblings. A node without
  // one is matched by its place.
  record node {
    id: option<string>,
    widget: widget,
    // The number of its children, which follow it.
    children: u32,
  }

  // A panel's tree, each node followed by its children and theirs, the
  // root first. A node cannot hold a node in this interface.
  record tree {
    nodes: list<node>,
  }

  // What `panel-view` returns: a tree built in code, or a program in
  // Hamlet's panel language, which the host evaluates into the tree.
  variant view {
    tree(tree),
    lang(string),
  }

  entry: func();

  step: func(inbox: list<incoming>) -> outgoing;

  panel-view: func(panel: string) -> view;
}

world hamlet {
  import host;
  export plugin;
}
