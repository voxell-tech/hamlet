  "control_tls": {
    "ca": "/etc/hamlet-workspace/control-ca.pem",
    "server_name": "api.ate-system.svc"
  },
  "router": "https://REPLACE_WITH_ATENET_ROUTER_HOST",
  "atespace": "REPLACE_WITH_ATESPACE",
  "template": "REPLACE_WITH_ACTOR_TEMPLATE",
  "idle_seconds": 300
}
