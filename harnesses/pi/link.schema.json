{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Hamlet harness link v1",
    "anyOf": [
        {
            "$ref": "#/$defs/ServerMessage"
        },
        {
            "$ref": "#/$defs/RuntimeMessage"
        }
    ],
    "$defs": {
        "Capability": {
            "enum": [
                "operations",
                "attempts",
                "admission",
                "cancel",
                "recovery",
                "updates",
                "history"
            ]
        },
        "ModelRef": {
            "type": "object",
            "required": ["provider", "id"],
            "properties": {
                "provider": {
                    "type": "string",
                    "minLength": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "baseUrl": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "Credential": {
            "type": "object",
            "required": ["type", "key"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "api_key"
                },
                "key": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "Usage": {
            "type": "object",
            "required": ["input", "output", "cacheRead", "cacheWrite", "cost"],
            "properties": {
                "input": {
                    "type": "integer",
                    "minimum": 0
                },
                "output": {
                    "type": "integer",
                    "minimum": 0
                },
                "cacheRead": {
                    "type": "integer",
                    "minimum": 0
                },
                "cacheWrite": {
                    "type": "integer",
                    "minimum": 0
                },
                "cost": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "ToolSpec": {
            "type": "object",
            "required": ["name", "description", "parameters", "replay"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "parameters": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {}
                    }
                },
                "replay": {
                    "enum": ["safe", "unsafe"]
                }
            },
            "additionalProperties": false
        },
        "Call": {
            "type": "object",
            "required": ["id", "name", "arguments"],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "arguments": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {}
                    }
                }
            },
            "additionalProperties": false
        },
        "Item": {
            "type": "object",
            "required": ["entry", "kind", "text"],
            "properties": {
                "entry": {
                    "type": "string",
                    "minLength": 1
                },
                "kind": {
                    "enum": ["user", "assistant", "tool_result", "other"]
                },
                "request": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                },
                "thinking": {
                    "type": "string"
                },
                "calls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Call"
                    }
                },
                "call": {
                    "type": "string"
                },
                "error": {
                    "type": "boolean"
                },
                "stop": {
                    "type": "string"
                },
                "usage": {
                    "$ref": "#/$defs/Usage"
                }
            },
            "additionalProperties": false
        },
        "Section": {
            "type": "object",
            "required": ["name", "text"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "text": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "ErrorCode": {
            "enum": [
                "malformed",
                "unknown_conversation",
                "unsupported",
                "failed"
            ]
        },
        "LinkError": {
            "type": "object",
            "required": ["type", "v", "id", "code", "message"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "error"
                },
                "v": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "re": {
                    "type": "string"
                },
                "code": {
                    "$ref": "#/$defs/ErrorCode"
                },
                "message": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "Hello": {
            "type": "object",
            "required": [
                "type",
                "v",
                "id",
                "versions",
                "adapter",
                "harness",
                "runtime",
                "store",
                "capabilities"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "hello"
                },
                "v": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "versions": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "adapter": {
                    "type": "string"
                },
                "harness": {
                    "type": "string"
                },
                "runtime": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "store": {
                    "enum": ["created", "opened", "missing"]
                },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Capability"
                    }
                }
            },
            "additionalProperties": false
        },
        "Welcome": {
            "type": "object",
            "required": ["type", "v", "id", "re", "version", "tools"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "welcome"
                },
                "v": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "re": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "integer",
                    "minimum": 1
                },
                "tools": {
                    "type": "array",
